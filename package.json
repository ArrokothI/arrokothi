{
  "name": "arrokothi-agent-kernel",
  "private": true,
  "version": "0.8.1",
  "description": "ArrokothI provider-neutral execution kernel workspace for long-lived Agents and Workflows.",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/kernel",
    "packages/sdk",
    "packages/models/gemini",
    "packages/retrieval/local",
    "packages/interoperability/mcp",
    "packages/agents/strands",
    "examples/execution-kernel-minimal"
  ],
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types packages/core/tests/*.test.ts packages/kernel/tests/*.test.ts packages/models/gemini/tests/*.test.ts packages/retrieval/local/tests/*.test.ts packages/agents/strands/tests/*.test.ts packages/interoperability/mcp/tests/*.test.ts tests/conformance/*/*.test.ts packages/sdk/tests/*.test.ts",
    "test:watch": "node --test --watch --experimental-strip-types packages/core/tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "example:execution-kernel": "node --experimental-strip-types examples/execution-kernel-minimal/main.ts",
    "test:example:execution-kernel": "node --test --experimental-strip-types examples/execution-kernel-minimal/*.test.ts",
    "canary:gemini": "node --env-file-if-exists=.env --experimental-strip-types scripts/gemini-provider-canary.ts",
    "canary:workflow": "node --env-file-if-exists=.env --experimental-strip-types scripts/workflow-scenario-canary.ts",
    "canary:mcp:gemini": "node --env-file-if-exists=.env --experimental-strip-types scripts/mcp-gemini-canary.ts",
    "test:core": "node --test --experimental-strip-types packages/core/tests/*.test.ts",
    "test:kernel": "node --test --experimental-strip-types packages/kernel/tests/*.test.ts",
    "test:retrieval-local": "node --test --experimental-strip-types packages/retrieval/local/tests/*.test.ts",
    "test:strands": "node --test --experimental-strip-types packages/agents/strands/tests/*.test.ts",
    "test:mcp": "node --test --experimental-strip-types packages/interoperability/mcp/tests/*.test.ts tests/conformance/mcp/*.test.ts",
    "test:conformance": "node --test --experimental-strip-types tests/conformance/*/*.test.ts",
    "test:evals": "node --test --experimental-strip-types tests/evals/*/*.eval.test.ts",
    "test:packages": "node --test --experimental-strip-types packages/core/tests/*.test.ts packages/kernel/tests/*.test.ts packages/models/gemini/tests/*.test.ts packages/retrieval/local/tests/*.test.ts packages/agents/strands/tests/*.test.ts packages/interoperability/mcp/tests/*.test.ts packages/sdk/tests/*.test.ts",
    "example:application-patterns": "node --experimental-strip-types examples/execution-kernel-minimal/patterns-main.ts",
    "check:builder-docs": "node --experimental-strip-types scripts/check-builder-docs.ts",
    "test:sdk": "node --test --experimental-strip-types packages/sdk/tests/*.test.ts",
    "test:archive-evidence": "node --test --experimental-strip-types tests/archive/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.0"
  }
}
