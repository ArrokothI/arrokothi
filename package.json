{
  "name": "agent-sdk-workspace",
  "private": true,
  "version": "0.37.0",
  "description": "Provider-neutral agent control plane with a consolidated Harness and Strands execution engine.",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/models/gemini",
    "packages/agents/strands",
    "packages/storage/sqlite",
    "apps/studio",
    "benchmarks",
    "examples/minimal-agent",
    "examples/estate-like",
    "examples/strands-gemini"
  ],
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "test": "node --test --experimental-sqlite --experimental-strip-types packages/core/tests/*.test.ts packages/models/gemini/tests/*.test.ts packages/agents/strands/tests/*.test.ts packages/storage/sqlite/tests/*.test.ts benchmarks/six-subject/tests/*.test.ts",
    "test:watch": "node --test --watch --experimental-strip-types packages/core/tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "studio": "node --experimental-strip-types --experimental-sqlite apps/studio/src/server.ts",
    "example:minimal": "node --experimental-strip-types examples/minimal-agent/main.ts",
    "example:estate": "node --experimental-strip-types examples/estate-like/main.ts",
    "example:strands": "node --env-file-if-exists=.env --experimental-strip-types examples/strands-gemini/main.ts",
    "canary:gemini": "node --env-file-if-exists=.env --experimental-strip-types scripts/gemini-provider-canary.ts",
    "test:core": "node --test --experimental-strip-types packages/core/tests/*.test.ts",
    "test:strands": "node --test --experimental-strip-types packages/agents/strands/tests/*.test.ts",
    "test:storage-sqlite": "node --test --experimental-sqlite --experimental-strip-types packages/storage/sqlite/tests/*.test.ts",
    "benchmark:test": "node --test --experimental-strip-types benchmarks/six-subject/tests/*.test.ts",
    "benchmark:generate": "node --env-file-if-exists=.env --experimental-strip-types benchmarks/six-subject/run.ts generate",
    "benchmark:evaluate": "node --experimental-strip-types benchmarks/six-subject/run.ts evaluate",
    "benchmark:judge": "node --env-file-if-exists=.env --experimental-strip-types benchmarks/six-subject/run.ts judge",
    "benchmark:analyze": "node --experimental-strip-types benchmarks/six-subject/run.ts analyze",
    "benchmark:review": "node --experimental-strip-types benchmarks/six-subject/run.ts review"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.0"
  }
}
