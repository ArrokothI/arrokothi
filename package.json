{
  "name": "agent-sdk-workspace",
  "private": true,
  "version": "0.37.0",
  "description": "Provider-neutral agent control plane with a consolidated Harness and Strands execution engine.",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/models/gemini",
    "packages/retrieval/local",
    "packages/agents/strands",
    "packages/storage/sqlite",
    "apps/studio",
    "examples/minimal-agent",
    "examples/estate-like",
    "examples/strands-gemini",
    "examples/benchmark/p01",
    "examples/benchmark/p02"
  ],
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "test": "node --test --experimental-sqlite --experimental-strip-types packages/core/tests/*.test.ts packages/models/gemini/tests/*.test.ts packages/retrieval/local/tests/*.test.ts packages/agents/strands/tests/*.test.ts packages/storage/sqlite/tests/*.test.ts tests/conformance/*/*.test.ts",
    "test:watch": "node --test --watch --experimental-strip-types packages/core/tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "studio": "node --experimental-strip-types --experimental-sqlite apps/studio/src/server.ts",
    "example:minimal": "node --experimental-strip-types examples/minimal-agent/main.ts",
    "example:estate": "node --experimental-strip-types examples/estate-like/main.ts",
    "example:strands": "node --env-file-if-exists=.env --experimental-strip-types examples/strands-gemini/main.ts",
    "example:benchmark:p01": "node --env-file-if-exists=.env --experimental-strip-types examples/benchmark/p01/main.ts",
    "example:benchmark:p02": "node --env-file-if-exists=.env --experimental-strip-types examples/benchmark/p02/main.ts",
    "test:benchmark-subjects": "node --test --experimental-strip-types examples/benchmark/p01/*.test.ts examples/benchmark/p02/*.test.ts",
    "canary:gemini": "node --env-file-if-exists=.env --experimental-strip-types scripts/gemini-provider-canary.ts",
    "canary:workflow": "node --env-file-if-exists=.env --experimental-strip-types scripts/workflow-scenario-canary.ts",
    "test:core": "node --test --experimental-strip-types packages/core/tests/*.test.ts",
    "test:retrieval-local": "node --test --experimental-strip-types packages/retrieval/local/tests/*.test.ts",
    "test:strands": "node --test --experimental-strip-types packages/agents/strands/tests/*.test.ts",
    "test:storage-sqlite": "node --test --experimental-sqlite --experimental-strip-types packages/storage/sqlite/tests/*.test.ts",
    "test:conformance": "node --test --experimental-strip-types tests/conformance/*/*.test.ts",
    "test:evals": "node --test --experimental-strip-types tests/evals/*/*.eval.test.ts",
    "test:packages": "node --test --experimental-sqlite --experimental-strip-types packages/core/tests/*.test.ts packages/models/gemini/tests/*.test.ts packages/retrieval/local/tests/*.test.ts packages/agents/strands/tests/*.test.ts packages/storage/sqlite/tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.0"
  }
}
