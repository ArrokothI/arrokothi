{
  "name": "agent-sdk-workspace",
  "private": true,
  "version": "0.37.0",
  "description": "Provider-neutral agent control plane with a consolidated Harness and Strands execution engine.",
  "type": "module",
  "workspaces": [
    "core",
    "providers/gemini",
    "integrations/strands",
    "apps/studio",
    "examples/minimal-agent",
    "examples/estate-like",
    "examples/strands-gemini"
  ],
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "test": "node --test --experimental-sqlite --experimental-strip-types core/tests/*.test.ts providers/gemini/tests/*.test.ts integrations/strands/tests/*.test.ts",
    "test:watch": "node --test --watch --experimental-strip-types core/tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "studio": "node --experimental-strip-types --experimental-sqlite apps/studio/src/server.ts",
    "example:minimal": "node --experimental-strip-types examples/minimal-agent/main.ts",
    "example:estate": "node --experimental-strip-types examples/estate-like/main.ts",
    "example:strands": "node --env-file-if-exists=.env --experimental-strip-types examples/strands-gemini/main.ts",
    "canary:gemini": "node --env-file-if-exists=.env --experimental-strip-types diagnostics/gemini-provider-canary.ts",
    "test:core": "node --test --experimental-strip-types core/tests/*.test.ts",
    "test:strands": "node --test --experimental-strip-types integrations/strands/tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.0"
  }
}
