# Copy this file to .env.local and fill in your values.
#   cp .env.example .env.local

# Google Gemini API key (https://aistudio.google.com/app/apikey)
# Used by components/AIConcierge.tsx via process.env.API_KEY (see vite.config.ts)
GEMINI_API_KEY=

# Note: the Gemini model names (e.g. gemini-2.5-flash) are hardcoded in
# components/AIConcierge.tsx, not read from an env var. Edit them there
# directly if you want to test a different model.

# Optional: only needed if testing the "send email" feature (api/send-email.ts)
GMAIL_USER=
GMAIL_APP_PASSWORD=
