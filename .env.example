# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# .env is git-ignored and is only read locally (via node's --env-file-if-exists flag) by the
# Gemini canary, benchmark generation/judging, and the live Strands/Gemini example. Offline tests,
# deterministic evaluation, analysis, and conversation rendering never need it.

# Required for live Gemini calls.
GEMINI_API_KEY=

# Generation model. There is no benchmark fallback when it is empty.
GEMINI_MODEL=

# Optional Agenerateor benchmark endpoint; defaults to the local Agenerateor API route.
AGENERATEOR_BENCHMARK_URL=

# Semantic and pairwise judge model. No fallback is used.
BENCHMARK_JUDGE_MODEL=
