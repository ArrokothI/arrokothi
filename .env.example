# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# .env is git-ignored and is only read locally (via node's --env-file-if-exists flag) by the
# Gemini canary, --live benchmark runs (bench:p01, bench:p02), and the live Strands/Gemini
# example (example:strands -- --live). Offline/self-check runs never need it.

# Required for --live runs. benchmark-rebuild-v1 specifically requires GEMINI_API_KEY.
GEMINI_API_KEY=

# Required by benchmark-rebuild-v1, which deliberately disables model fallback. Older examples may
# still use their documented default when this is empty.
GEMINI_MODEL=

# Required for live evaluator-v2 semantic and pairwise judging. No fallback is used.
BENCHMARK_JUDGE_MODEL=
