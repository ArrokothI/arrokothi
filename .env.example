# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# .env is git-ignored and is only read locally (via node's --env-file-if-exists flag) by the
# optional live-provider canaries and the live Strands/Gemini example. Offline tests, deterministic
# evaluation, analysis, and conversation rendering never need it.

# Required for live Gemini calls.
GEMINI_API_KEY=

# Model id for the live canaries and the Strands/Gemini example. Read rather than hardcoded; the
# canaries that require it fail closed when it is empty.
GEMINI_MODEL=
