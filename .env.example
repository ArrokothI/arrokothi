# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# .env is git-ignored and is only read locally (via node's --env-file-if-exists flag) by the
# --live benchmark runs (bench:p01, bench:p02) and the live Strands/Gemini example
# (example:strands -- --live). Offline/self-check runs never need it.

# Required for --live runs. Also accepted: GOOGLE_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY.
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite if unset. A --model=<id> CLI flag, when passed,
# always wins over this.
GEMINI_MODEL=
