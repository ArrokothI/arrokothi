/**
 * Validation-14/09: line-ending transition audit for K10-R13-01.
 *
 * Each window prints one row per physical line: container depth before/after, fence/HTML
 * state with the owning depth (`@n`), structural classification, heading/table eligibility
 * on that line, and a `lines == transitions` check, which holds everywhere. C is the
 * committed production parser imported from its real path.
 */
import { scanTransitions } from "/Users/rex-shih/Documents/ArrokothI/arrokothi/tests/conformance/architecture/inventory-oracle.ts";
import { readFile } from "node:fs/promises";

const show = (title: string, doc: string): void => {
  const lines = doc.split(/\r\n|\r|\n/);
  const tr = scanTransitions(doc);
  console.log(`--- ${title} (${lines.length} physical lines, ${tr.length} transitions, equal=${lines.length === tr.length})`);
  for (const t of tr) {
    console.log(
      `L${t.index} d${t.depthBefore}->d${t.depthAfter}${t.containers === null ? "" : `(${t.containers})`} ` +
      `fb=${t.fenceBefore} hb=${t.htmlBefore} => ${t.classification} ` +
      `fa=${t.fenceAfter} ha=${t.htmlAfter}` +
      `${t.containerClosedLeaf ? " CLOSED-BY-CONTAINER" : ""} head=${t.headingAllowed ? "Y" : "-"} tab=${t.tableAllowed ? "Y" : "-"} | ${JSON.stringify(t.text.slice(0, 52))}`,
    );
  }
};

show("A lone-CR primitives delimit", "a\rb");
show("B CRLF primitives delimit", "a\r\nb");
show("C LF primitives delimit", "a\nb");
show("D trailing endings each yield one final empty line", "a\r");
show("E no trailing ending yields none", "a");
show("F lone-CR raw-block lifetime matches LF", "<div>\r## What this packet does not establish\r\r| Id | X |\r|---|---|---|\r| DX-1 | y |\r");
show("G mixed endings keep one transition per physical line", "- note\r\n\r  ```\r  code\r\n## Current cross-boundary dependencies\n");

const real = await readFile("/Users/rex-shih/Documents/ArrokothI/arrokothi/docs/development/work/K1.0/ownership-inventory.md", "utf8");
const tr = scanTransitions(real);
const crOnly = real.replace(/\r?\n/g, "\r");
const trCr = scanTransitions(crOnly);
console.log(`--- H clean-document spot check (LF ${tr.length} transitions for ${real.split("\n").length} LF lines; CR-only ${trCr.length} transitions; equal=${tr.length === trCr.length})`);
console.log(`texts identical: ${JSON.stringify(tr.map((t) => t.text)) === JSON.stringify(trCr.map((t) => t.text))}`);
console.log(`containerClosedLeaf ever true: ${tr.some((t) => t.containerClosedLeaf) || trCr.some((t) => t.containerClosedLeaf)}`);
--- end /tmp/k10r14/demo09.ts ---
