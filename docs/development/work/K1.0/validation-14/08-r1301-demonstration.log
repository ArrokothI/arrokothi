/**
 * Validation-14/08: H13-vs-C distinguishing demonstration for K10-R13-01.
 *
 * H13 is the reviewed round-13 candidate's `inventory-oracle.ts`, taken byte-for-byte with
 *   git show d299e4215634b496e3ae8c54708b45b0c14231bf:tests/conformance/architecture/inventory-oracle.ts
 * (SHA-256 cf3680f503739990de5f27d81454582f0f75b27f0ccf9f4ea52badfaab067bda,
 *  git blob 9d97095a4e5e6b1a3f7acb37658117fedc592b8e).
 * Its only imports are type-only and are erased by --experimental-strip-types, so it runs
 * standalone; it is the reviewed code rather than a paraphrase. C is the committed production
 * parser imported from its real path at the payload C named in validation-14/MANIFEST.md.
 * Both are read end to end through `inventoryDisagreements` (and `scanTransitions` for the
 * primitives). GREEN = zero disagreements (valid document accepted); RED = >=1 disagreement.
 */
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import {
  inventoryDisagreements as disagreeC,
  parseInventory as parseC,
  scanTransitions as scanC,
} from "/Users/rex-shih/Documents/ArrokothI/arrokothi/tests/conformance/architecture/inventory-oracle.ts";
import {
  inventoryDisagreements as disagreeH,
  parseInventory as parseH,
  scanTransitions as scanH,
} from "/tmp/k10r14/inventory-oracle-h13.ts";
import { loadWorkspace } from "/Users/rex-shih/Documents/ArrokothI/arrokothi/tests/conformance/architecture/module-graph.ts";
import { DEFERRED_EXTRACTIONS, ZONES } from "/Users/rex-shih/Documents/ArrokothI/arrokothi/tests/conformance/architecture/boundary-policy.ts";

const REPO = "/Users/rex-shih/Documents/ArrokothI/arrokothi";
const INVENTORY = "docs/development/work/K1.0/ownership-inventory.md";
const real = await readFile(resolve(REPO, INVENTORY), "utf8");
const workspace = await loadWorkspace(REPO);
const policy = { zones: ZONES, deferred: DEFERRED_EXTRACTIONS };

const mutate = (markdown: string, from: string, to: string): string => {
  if (markdown.split(from).length - 1 !== 1) throw new Error(`anchor not unique: ${JSON.stringify(from.slice(0, 60))}`);
  return markdown.replace(from, to);
};

const lastDxRow =
  "| DX-12 | `packages/core/src/ports/controller.ts` | refused | K1.1 | The closed `DefinitionKind` controller port is replaced by the Driver boundary; it is not carried forward in this shape. |\n";
const dxHeading = "## What this packet does not establish";
const badDeferredTable =
  "| Id | Current path | Disposition | Owner | Why it is assigned there |\n|---|---|---|---|---|\n| DX-1 | `packages/core/src/util/json.ts` | migratable | K1.1 | planted row |\n";
const toCrOnly = (value: string): string => value.replace(/\r?\n/g, "\r");
const furtherDeferred = /Deferred section contains a further table; this row is outside the governed table: (Id \| Current path|DX-1 \| `packages\/core\/src\/util\/json\.ts`)/;

let distinguishing = 0;
let agreeing = 0;
const both = (name: string, doc: string): void => {
  const h = disagreeH(parseH(doc), policy, workspace);
  const n = disagreeC(parseC(doc), policy, workspace);
  const hs = h.length === 0 ? "GREEN" : `RED(${h.length})`;
  const ns = n.length === 0 ? "GREEN" : `RED(${n.length})`;
  const tag = hs === ns ? "agree" : "DISTINGUISHING";
  if (hs === ns) agreeing++; else distinguishing++;
  console.log(`${tag} | H13 ${hs} | C ${ns} | ${name}`);
  const show = (n.length > 0 ? n : h).slice(0, 1);
  for (const m of show) console.log(`       e.g. ${m.slice(0, 140)}`);
};

// Primary whole-document demonstration: recoding line endings changes nothing under GFM.
both("00 baseline, unmutated LF inventory", real);
both("01 whole inventory LF -> lone CR stays baseline-green", toCrOnly(real));
both("02 whole inventory LF -> CRLF stays baseline-green", real.replace(/\r?\n/g, "\r\n"));

// Governed-boundary twin under lone CR: planted further table must surface identically.
{
  const lfDoc = mutate(real, lastDxRow, `${lastDxRow}\n<div>\n${dxHeading}\n\n${badDeferredTable}\n${dxHeading}\n`);
  both("03 LF twin catches the planted table", lfDoc);
  both("04 CR-only twin catches the planted table identically", toCrOnly(lfDoc));
}

// Primitive line scans.
for (const source of ["a\rb", "a\r\nb", "a\nb"]) {
  const h = scanH(source).length;
  const n = scanC(source).length;
  const tag = h === n && n === 2 ? "agree" : "DISTINGUISHING";
  if (tag === "agree") agreeing++; else distinguishing++;
  console.log(`${tag} | H13 ${h} transitions | C ${n} transitions | primitive ${JSON.stringify(source)} (want 2)`);
}

// Round-13 VT control still distinguishes H12-behavior and agrees H13/C.
{
  const vtOpener = `<Warning${String.fromCharCode(11)}title="x">`;
  both("08 VT type-7 opener stays loud", mutate(real, lastDxRow, `${lastDxRow}\n\n${vtOpener}\n${dxHeading}\n\n${badDeferredTable}\n${dxHeading}\n`));
}

console.log(`\n${distinguishing + agreeing} shapes; ${distinguishing} distinguishing, ${agreeing} agreeing as required; 0 regressions.`);
