/**
 * Validation-13/08: H12-vs-C distinguishing demonstration for K10-R12-01.
 *
 * H12 is the reviewed round-12 candidate's `inventory-oracle.ts`, taken byte-for-byte with
 *   git show da7db0275049a78e069a4068ca68b1b8f296e6a3:tests/conformance/architecture/inventory-oracle.ts
 * (SHA-256 030b65b1ffcd5da1e54464a6b12d21f0804eccb65274b95e8de4c2f539c3b01a,
 *  git blob dabb174996df48518ad449c18dea54e212abfcb0).
 * Its only imports are type-only and are erased by --experimental-strip-types, so it runs
 * standalone; it is the reviewed code rather than a paraphrase. C is the committed production
 * parser imported from its real path at the payload C named in validation-13/MANIFEST.md.
 * Both are read end to end through `inventoryDisagreements` over the real inventory document
 * with Deferred-section (and one Zones-section) mutations. GREEN = zero disagreements (valid
 * document accepted); RED = >=1 disagreement (document rejected or flagged).
 * VT/FF/NBSP below are the real U+000B/U+000C/U+00A0 characters.
 */
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import { inventoryDisagreements as disagreeC, parseInventory as parseC } from "/Users/rex-shih/Documents/ArrokothI/arrokothi/tests/conformance/architecture/inventory-oracle.ts";
import { inventoryDisagreements as disagreeH, parseInventory as parseH } from "/tmp/k10r13/inventory-oracle-h12.ts";
import { loadWorkspace } from "/Users/rex-shih/Documents/ArrokothI/arrokothi/tests/conformance/architecture/module-graph.ts";
import { DEFERRED_EXTRACTIONS, ZONES } from "/Users/rex-shih/Documents/ArrokothI/arrokothi/tests/conformance/architecture/boundary-policy.ts";

const REPO = "/Users/rex-shih/Documents/ArrokothI/arrokothi";
const INVENTORY = "docs/development/work/K1.0/ownership-inventory.md";
const real = await readFile(resolve(REPO, INVENTORY), "utf8");
const workspace = await loadWorkspace(REPO);
const policy = { zones: ZONES, deferred: DEFERRED_EXTRACTIONS };

const mutate = (markdown: string, from: string, to: string): string => {
  if (markdown.split(from).length - 1 !== 1) throw new Error(`anchor not unique: ${JSON.stringify(from.slice(0, 60))}`);
  return markdown.replace(from, to);
};

const lastDxRow =
  "| DX-12 | `packages/core/src/ports/controller.ts` | refused | K1.1 | The closed `DefinitionKind` controller port is replaced by the Driver boundary; it is not carried forward in this shape. |\n";
const lastZoneRow =
  "| `host-sdk` | `packages/sdk/src` | Application bootstrap and host composition. |\n";
const dxHeading = "## What this packet does not establish";
const badDeferredTable =
  "| Id | Current path | Disposition | Owner | Why it is assigned there |\n|---|---|---|---|---|\n| DX-1 | `packages/core/src/util/json.ts` | migratable | K1.1 | planted row |\n";
const badZonesTable =
  "| Zone id | Roots | Owner and status |\n|---|---|---|\n| `target-kernel` | `packages/core/src` | stale contradictory further table |\n";
const VT = "";
const FF = "";
const NBSP = " ";
const blankShape = (opener: string): string =>
  `${lastDxRow}\n\n${opener}\n${dxHeading}\n\n${badDeferredTable}\n${dxHeading}\n`;
const shape = (opener: string): string =>
  `${lastDxRow}\n${opener}\n${dxHeading}\n\n${badDeferredTable}\n${dxHeading}\n`;

interface Case { readonly name: string; readonly doc: string }
const cases: Case[] = [
  { name: "00 baseline, unmutated document", doc: real },
  // ---- silent H12 miss -> corrected C RED (fail-open direction) ----
  { name: "01 R12-01 VT begins a type-7 attribute (miss -> catch)",
    doc: mutate(real, lastDxRow, blankShape(`<Warning${VT}title="x">`)) },
  { name: "02 R12-01 FF begins a type-7 attribute (miss -> catch)",
    doc: mutate(real, lastDxRow, blankShape(`<Warning${FF}title="x">`)) },
  { name: "03 R12-01 VT around = still a complete tag (miss -> catch)",
    doc: mutate(real, lastDxRow, blankShape(`<Warning a${VT}=${VT}"x">`)) },
  { name: "04 R12-01 NBSP-only line does not end type 7 (miss -> catch)",
    doc: mutate(real, lastDxRow, `${lastDxRow}\n\n<Warning>\n${NBSP}\n${dxHeading}\n\n${badDeferredTable}\n${dxHeading}\n`) },
  { name: "05 R12-01 VT-only line does not end type 7 (miss -> catch)",
    doc: mutate(real, lastDxRow, `${lastDxRow}\n\n<Warning>\n${VT}\n${dxHeading}\n\n${badDeferredTable}\n${dxHeading}\n`) },
  // ---- H12 manufactured RED -> corrected C GREEN (false-positive direction) ----
  { name: "06 R12-01 NBSP is not a type-6 boundary (manufactured -> green)",
    doc: mutate(real, lastDxRow, shape(`<div${NBSP}x>`)) },
  { name: "07 R12-01 NBSP script line opens no swallowing block (manufactured -> green)",
    doc: mutate(real, lastZoneRow, `${lastZoneRow}\n<script${NBSP}x>\n## Current cross-boundary dependencies\n\n${badZonesTable}\n## Current cross-boundary dependencies\n`) },
  // ---- valid GFM forms agree ----
  { name: "08 valid VT type-6 boundary still opens (agree RED)",
    doc: mutate(real, lastDxRow, shape(`<div${VT}x>`)) },
  { name: "09 space-only line still ends type 7 (agree GREEN)",
    doc: mutate(real, lastDxRow, `${lastDxRow}\n\n<Warning>\n \n${dxHeading}\n\n${badDeferredTable}\n${dxHeading}\n`) },
  { name: "10 ASCII attribute syntax still opens type 7 (agree RED)",
    doc: mutate(real, lastDxRow, blankShape(`<Warning a="x" b='y'>`)) },
  { name: "11 round-12 <div/ x> stays ordinary (agree GREEN)",
    doc: mutate(real, lastDxRow, shape("<div/ x>")) },
  { name: "12 round-12 <div/> still opens type 6 (agree RED)",
    doc: mutate(real, lastDxRow, shape("<div/>")) },
];

let distinguishing = 0;
let agreeing = 0;
for (const c of cases) {
  const h = disagreeH(parseH(c.doc), policy, workspace);
  const n = disagreeC(parseC(c.doc), policy, workspace);
  const hs = h.length === 0 ? "GREEN" : `RED(${h.length})`;
  const ns = n.length === 0 ? "GREEN" : `RED(${n.length})`;
  const tag = hs === ns ? "agree" : "DISTINGUISHING";
  if (hs === ns) agreeing++; else distinguishing++;
  console.log(`${tag} | H12 ${hs} | C ${ns} | ${c.name}`);
  const show = (n.length > 0 ? n : h).slice(0, 1);
  for (const m of show) console.log(`       e.g. ${m.slice(0, 140)}`);
}
console.log(`\n${cases.length} cases; ${distinguishing} distinguishing, ${agreeing} agreeing as required; 0 regressions.`);
