/**
 * Validation-13/09: GFM whitespace/blank-line lexical and transition audit (K10-R12-01).
 *
 * Each window prints one row per physical line: container depth before/after, fence/HTML
 * state with the owning depth (`@n`), structural classification, `CLOSED-BY-CONTAINER`
 * where the line ended an owned leaf, heading/table eligibility on that same line, and a
 * `lines == transitions` check, which holds everywhere. C is the committed production
 * parser imported from its real path. VT/FF/NBSP are the real U+000B/U+000C/U+00A0.
 */
import { scanTransitions } from "/Users/rex-shih/Documents/ArrokothI/arrokothi/tests/conformance/architecture/inventory-oracle.ts";
import { readFile } from "node:fs/promises";

const VT = "";
const FF = "";
const NBSP = " ";

const show = (title: string, doc: string): void => {
  const lines = doc.split("\n");
  const tr = scanTransitions(doc);
  console.log(`--- ${title} (${lines.length} lines, ${tr.length} transitions, equal=${lines.length === tr.length})`);
  for (const t of tr) {
    console.log(
      `L${t.index} d${t.depthBefore}->d${t.depthAfter}${t.containers === null ? "" : `(${t.containers})`} ` +
      `fb=${t.fenceBefore} hb=${t.htmlBefore} => ${t.classification} ` +
      `fa=${t.fenceAfter} ha=${t.htmlAfter}` +
      `${t.containerClosedLeaf ? " CLOSED-BY-CONTAINER" : ""} head=${t.headingAllowed ? "Y" : "-"} tab=${t.tableAllowed ? "Y" : "-"} | ${JSON.stringify(t.text.slice(0, 52))}`,
    );
  }
};

show("A VT begins a type-7 attribute; heading raw, blank ends", [`<Warning${VT}title="x">`, "## What this packet does not establish", "", "| Id | X |"].join("\n"));
show("B NBSP is no type-6 boundary; heading eligible same line", [`<div${NBSP}x>`, "## What this packet does not establish"].join("\n"));
show("C NBSP script line is ordinary prose, not type 1", [`<script${NBSP}x>`, "## What this packet does not establish"].join("\n"));
show("D VT is a valid type-6 boundary", [`<div${VT}x>`, "## What this packet does not establish"].join("\n"));
show("E NBSP-only line continues type 7 across it", ["<Warning>", NBSP, "## What this packet does not establish"].join("\n"));
show("F space-only line still ends type 7", ["<Warning>", " ", "## What this packet does not establish"].join("\n"));
show("G1 VT around = still a complete type-7 tag", [`<Warning a${VT}=${VT}"x">`, "## What this packet does not establish"].join("\n"));
show("G2 FF before > still a complete type-7 tag", [`<Warning a="x"${FF}>`, "## What this packet does not establish"].join("\n"));

const real = await readFile("/Users/rex-shih/Documents/ArrokothI/arrokothi/docs/development/work/K1.0/ownership-inventory.md", "utf8");
const tr = scanTransitions(real);
const nonTop = tr.filter((t) => t.depthBefore > 0 || t.depthAfter > 0);
console.log(`--- H clean-document spot check (${tr.length} transitions for ${real.split("\n").length} lines, equal=${tr.length === real.split("\n").length})`);
console.log(`container-local transitions: ${nonTop.length}; containerClosedLeaf ever true: ${tr.some((t) => t.containerClosedLeaf)}`);
