/**
 * Validation-11/09: container/leaf ownership transition audit for K10-R10-01/-02/-03.
 *
 * For every leaf state the audit shows: which container depth owns it (the @n suffix on
 * fence/html state), how its normal close works, what happens when that container closes
 * first (containerClosedLeaf=true), whether the current physical line belonged to the old
 * container or the parent (depthBefore vs depthAfter), and whether heading/table recognition
 * runs after the close (headingAllowed/tableAllowed on that same line).
 * C is the committed production parser imported from its real path.
 */
import { scanTransitions } from "/Users/rex-shih/Documents/ArrokothI/arrokothi/tests/conformance/architecture/inventory-oracle.ts";
import { readFile } from "node:fs/promises";

const show = (title: string, doc: string): void => {
  const lines = doc.split("\n");
  const tr = scanTransitions(doc);
  console.log(`--- ${title} (${lines.length} lines, ${tr.length} transitions, equal=${lines.length === tr.length})`);
  for (const t of tr) {
    console.log(
      `L${t.index} d${t.depthBefore}->d${t.depthAfter}${t.containers === null ? "" : `(${t.containers})`} ` +
      `fb=${t.fenceBefore} hb=${t.htmlBefore} => ${t.classification} ` +
      `fa=${t.fenceAfter} ha=${t.htmlAfter}` +
      `${t.containerClosedLeaf ? " CLOSED-BY-CONTAINER" : ""} head=${t.headingAllowed ? "Y" : "-"} tab=${t.tableAllowed ? "Y" : "-"} | ${JSON.stringify(t.text.slice(0, 52))}`,
    );
  }
};

show("A bullet unclosed fence dies with its item; heading eligible same line", ["- note", "", "  ```", "  literal list-local code", "## Current cross-boundary dependencies"].join("\n"));
show("B ordered unclosed fence, same ownership", ["1. note", "", "   ```", "   literal", "## Current cross-boundary dependencies"].join("\n"));
show("C list-local type-7 without blank end dies with its item", ["- note", "", "  <Warning>", "## What this packet does not establish"].join("\n"));
show("D list-local script dies at a dedented table; table eligible same line", ["- note", "", "  <script>", "| Id | X |", "|---|---|", "| DX-1 | y |", "## What this packet does not establish"].join("\n"));
show("E properly closed list-local fence: closer, no kill, heading ordinary", ["- note", "", "  ```", "  code", "  ```", "## What this packet does not establish"].join("\n"));
show("F top-level unclosed fence (owner 0) keeps run-to-document-end", ["```", "## What this packet does not establish"].join("\n"));
show("G nested: inner kill keeps outer content; outer kill delimits", ["- outer", "", "  - inner", "", "    ```", "    code", "  ## What this packet does not establish", "## What this packet does not establish"].join("\n"));
show("H missing-whitespace tag never opens; valid multi-attribute tag opens type 7", ["<a href='bar'title=title>", "", '<Warning a="x" b=\'y\' c=z>', "## What this packet does not establish"].join("\n"));
show("I textarea type 7 ends at blank; without blank it continues", ["<textarea>", "", "## What this packet does not establish", "---", "<textarea>", "## What this packet does not establish"].join("\n"));
show("J search trailing prose ordinary; complete search alone opens type 7", ["<search> trailing prose", "## What this packet does not establish", "---", "<search>", "## What this packet does not establish"].join("\n"));

const real = await readFile("/Users/rex-shih/Documents/ArrokothI/arrokothi/docs/development/work/K1.0/ownership-inventory.md", "utf8");
const tr = scanTransitions(real);
const nonTop = tr.filter((t) => t.depthBefore > 0 || t.depthAfter > 0);
console.log(`--- K clean-document spot check (${tr.length} transitions for ${real.split("\n").length} lines, equal=${tr.length === real.split("\n").length})`);
console.log(`container-local transitions: ${nonTop.length}; classifications: ${[...new Set(nonTop.map((t) => t.classification))].join(",") || "(none)"}; containerClosedLeaf ever true: ${tr.some((t) => t.containerClosedLeaf)}`);
