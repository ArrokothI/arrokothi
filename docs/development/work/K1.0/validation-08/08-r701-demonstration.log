The demonstration program, in full (it enters no tracked path):

```ts
/**
 * 08 — K10-R7-01 demonstration: reviewed H7 reader vs committed C reader.
 *
 * H7 is the reviewed candidate's `inventory-oracle.ts` taken byte-for-byte with
 * `git show 2dfc6d8:…`; both of its imports are `import type` and are erased by
 * `--experimental-strip-types`, so it runs standalone and is the reviewed code rather than a
 * paraphrase. C is the committed production parser imported from its real path. Both are read
 * end to end through `inventoryDisagreements` plus `parseDependencyTable`, with the policy and
 * workspace from the committed tree (untouched by this correction).
 */
import { readFile, writeFile } from "node:fs/promises";
import { execFileSync } from "node:child_process";
import { resolve, dirname } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const REPO = "/Users/rex-shih/Documents/ArrokothI/arrokothi";
const H7_SHA = "2dfc6d818498263c30cb64db32a91aa0ac0543a5";
const TMP = "/var/folders/c3/jvkvjr6d701gtyf5sf6gn_fw0000gn/T/opencode";
const H7_PATH = `${TMP}/inventory-oracle-h7.ts`;

const h7Source: string = execFileSync(
  "git",
  ["show", `${H7_SHA}:tests/conformance/architecture/inventory-oracle.ts`],
  { cwd: REPO, encoding: "utf8" },
) as unknown as string;
await writeFile(H7_PATH, h7Source, "utf8");

const h7 = await import(pathToFileURL(H7_PATH).href);
const c = await import(pathToFileURL(resolve(REPO, "tests/conformance/architecture/inventory-oracle.ts")).href);
const { loadWorkspace } = await import(pathToFileURL(resolve(REPO, "tests/conformance/architecture/module-graph.ts")).href);
const { ZONES, DEFERRED_EXTRACTIONS } = await import(pathToFileURL(resolve(REPO, "tests/conformance/architecture/boundary-policy.ts")).href);

const inventory = await readFile(resolve(REPO, "docs/development/work/K1.0/ownership-inventory.md"), "utf8");
const workspace = await loadWorkspace(REPO);
const policy = { zones: ZONES, deferred: DEFERRED_EXTRACTIONS };

const lastZoneRow = "| `host-sdk` | `packages/sdk/src` | Application bootstrap and host composition. |\n";
const badZonesTable =
  "| Zone id | Roots | Owner and status |\n|---|---|---|\n| `target-kernel` | `packages/core/src` | stale contradictory further table |\n";
const furtherZones = (messages: string[]): string[] =>
  messages.filter((m) => m.includes("Zones section contains a further table"));

let failures = 0;
const check = (name: string, h7mut: string, cmut: string, expect: (h: string[], cc: string[]) => boolean): void => {
  const h = h7.inventoryDisagreements(h7.parseInventory(h7mut), policy, workspace);
  const cc = c.inventoryDisagreements(c.parseInventory(cmut), policy, workspace);
  const ok = expect(h, cc);
  console.log(`${ok ? "PASS" : "FAIL"} ${name}`);
  console.log(`  H7: ${h.length} messages; C: ${cc.length} messages`);
  for (const m of cc.slice(0, 3)) console.log(`  C e.g.: ${m}`);
  if (!ok) failures++;
};

const reviewLiteral =
  `${lastZoneRow}\nThe literal token \`## Current cross-boundary\` is mentioned here; this line is prose, not an ATX heading.\n\n` +
  `| Zone id | Roots | Owner and status |\n|---|---|---|\n| \`target-kernel\` | \`packages/core/src\` | stale contradictory further table |\n`;
check(
  "review-07 literal: prose next-heading mention hides a further table",
  inventory.replace(lastZoneRow, reviewLiteral),
  inventory.replace(lastZoneRow, reviewLiteral),
  (h, cc) => furtherZones(h).length === 0 && furtherZones(cc).length > 0,
);

const fenced =
  `${lastZoneRow}\n\`\`\`\n## Current cross-boundary dependencies\n\`\`\`\n\n${badZonesTable}`;
check(
  "fenced next-heading mention hides a further table",
  inventory.replace(lastZoneRow, fenced),
  inventory.replace(lastZoneRow, fenced),
  (h, cc) => furtherZones(h).length === 0 && furtherZones(cc).length > 0,
);

const terminated = inventory.replace(
  "## Current cross-boundary dependencies\n",
  `## Current cross-boundary dependencies\n\n${badZonesTable}`,
);
check(
  "real ATX next heading terminates (both green on Zones)",
  terminated,
  terminated,
  (h, cc) => furtherZones(h).length === 0 && furtherZones(cc).length === 0,
);

const proseStart = inventory.replace(
  "## Zones\n",
  `See ## Zones below.\n\n| Zone id | Roots | Owner and status |\n|---|---|---|\n| \`target-kernel\` | \`packages/core/src\` | planted before section |\n\n## Zones\n`,
);
check(
  "prose start mention: H7 mis-selects, C stays outside (green)",
  proseStart,
  proseStart,
  (h, cc) => h.length > 0 && cc.length === 0,
);

const self12 = inventory.replace(
  lastZoneRow,
  `${lastZoneRow}\n## Zones\n\n| Zone id | Roots | Owner and status |\n|---|---|---|\n| \`target-kernel\` | \`packages/core/src\` | stale contradictory row |\n`,
);
check("SELF-12 repeated heading (reported both)", self12, self12, (h, cc) =>
  furtherZones(h).length > 0 && furtherZones(cc).length > 0);

const self13 = inventory.replace(
  lastZoneRow,
  `${lastZoneRow}\n| \`target-kernel\` | \`packages/core/src\` | stale contradictory row |\n|---|---|---|\n`,
);
check("SELF-13 promoted further-table row (reported both)", self13, self13, (h, cc) =>
  furtherZones(h).length > 0 && furtherZones(cc).length > 0);

const headerLabel =
  "| `target-kernel` | `packages/kernel/src` | New Kernel work under the target Activation/Outcome protocol. **Contains no protocol implementation at this revision.** |";
const headerLabelMut = inventory.replace(
  headerLabel,
  `| Zone id | \`packages/core/src\` | stale contradictory body row |\n${headerLabel}`,
);
check("K10-R6-01 header-label body row (reported both)", headerLabelMut, headerLabelMut, (h, cc) =>
  h.length > 0 && cc.length > 0);

const escaped = inventory.replace(lastZoneRow, `${lastZoneRow}\n\\## Current cross-boundary dependencies\n\n${badZonesTable}`);
check("SELF-14 escaped hash (H7 silent, C reported)", escaped, escaped, (h, cc) =>
  furtherZones(h).length === 0 && furtherZones(cc).length > 0);

const nospace = inventory.replace(lastZoneRow, `${lastZoneRow}\n##Current cross-boundary dependencies\n\n${badZonesTable}`);
{
  const h = h7.inventoryDisagreements(h7.parseInventory(nospace), policy, workspace);
  const cc = c.inventoryDisagreements(c.parseInventory(nospace), policy, workspace);
  const ok = furtherZones(h).length > 0 && furtherZones(cc).length > 0;
  console.log(`${ok ? "PASS" : "FAIL"} SELF-15 no-whitespace line (not a heading under either reader; both report)`);
  console.log(`  H7: ${h.length} messages; C: ${cc.length} messages`);
  if (!ok) failures++;
}

const indented = inventory.replace(lastZoneRow, `${lastZoneRow}\n    ## Current cross-boundary dependencies\n\n${badZonesTable}`);
check("SELF-16 indented code (H7 silent, C reported)", indented, indented, (h, cc) =>
  furtherZones(h).length === 0 && furtherZones(cc).length > 0);

const mismatch = inventory.replace(
  lastZoneRow,
  `${lastZoneRow}\n\`\`\`\n## Current cross-boundary dependencies\n~~~\n\`\`\`\n\n${badZonesTable}`,
);
check("SELF-17 mismatched fence (H7 silent, C reported)", mismatch, mismatch, (h, cc) =>
  furtherZones(h).length === 0 && furtherZones(cc).length > 0);

console.log(failures === 0 ? "ALL DEMONSTRATION CASES BEHAVE AS CLAIMED" : `${failures} CASES DIVERGED`);
process.exit(failures === 0 ? 0 : 1);
```

