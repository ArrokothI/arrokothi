# 09 — silent-exit audit of the whole C4 row pipeline, clean payload C

$ node --experimental-strip-types audit.ts

The audit program, in full (it enters no tracked path; it reads the committed inventory and
the production parser from their real paths and prints every branch's whole observable result):

```ts
/**
 * 09 — silent-exit audit of the whole C4 row pipeline, clean payload C.
 *
 * Every branch that can end a row's life is driven with an input that actually reaches it,
 * through the production parser, and its whole observable result is printed. Stage 1 repeats the
 * section-selection part of the audit with the full heading-context matrix: every way a candidate
 * heading token can be encountered (real ATX heading, paragraph text, inline code, fenced code,
 * escaped text, malformed heading-like line), with the reason each starts/ends the section,
 * remains ordinary content, or produces an explicit disagreement.
 */
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import { pathToFileURL } from "node:url";

const REPO = "/Users/rex-shih/Documents/ArrokothI/arrokothi";
const oracle = await import(pathToFileURL(resolve(REPO, "tests/conformance/architecture/inventory-oracle.ts")).href);
const { loadWorkspace } = await import(pathToFileURL(resolve(REPO, "tests/conformance/architecture/module-graph.ts")).href);
const { ZONES, DEFERRED_EXTRACTIONS } = await import(pathToFileURL(resolve(REPO, "tests/conformance/architecture/boundary-policy.ts")).href);

const inventory = await readFile(resolve(REPO, "docs/development/work/K1.0/ownership-inventory.md"), "utf8");
const workspace = await loadWorkspace(REPO);
const policy = { zones: ZONES, deferred: DEFERRED_EXTRACTIONS };

const show = (title: string, messages: string[]): void => {
  console.log(`### ${title}`);
  if (messages.length === 0) console.log("  (no message)");
  for (const m of messages) console.log(`  - ${m}`);
};

const zonesDisagreements = (mutated: string): string[] =>
  oracle.inventoryDisagreements(oracle.parseInventory(mutated), policy, workspace);

const lastZoneRow = "| `host-sdk` | `packages/sdk/src` | Application bootstrap and host composition. |\n";
const badZonesTable =
  "| Zone id | Roots | Owner and status |\n|---|---|---|\n| `target-kernel` | `packages/core/src` | stale contradictory further table |\n";

console.log("## Stage 1 — section selection (heading-context matrix)");
show("1a — the section heading itself is absent (renamed heading)", zonesDisagreements(inventory.replace("## Zones\n", "## Zone catalogue\n")));
show(
  "1b — the next heading is absent, so the section runs on into the following table",
  zonesDisagreements(inventory.replace("## Current cross-boundary dependencies\n", "")),
);
show(
  "1c — a real ATX next heading terminates: planted Zones rows after it are outside (green)",
  zonesDisagreements(
    inventory.replace("## Current cross-boundary dependencies\n", `## Current cross-boundary dependencies\n\n${badZonesTable}`),
  ),
);
show(
  "1d — the heading occurs a second time, with a contradictory table under it (K1.0-SELF-12 stays inside, reported)",
  zonesDisagreements(
    inventory.replace(lastZoneRow, `${lastZoneRow}\n## Zones\n\n${badZonesTable}`),
  ),
);
show(
  "1e — paragraph text carrying the full next-heading bytes stays content (reported)",
  zonesDisagreements(
    inventory.replace(lastZoneRow, `${lastZoneRow}\nThe literal token ## Current cross-boundary dependencies is mentioned here.\n\n${badZonesTable}`),
  ),
);
show(
  "1f — the bytes inside an inline code span stay content (reported)",
  zonesDisagreements(
    inventory.replace(lastZoneRow, `${lastZoneRow}\nThe literal token \`## Current cross-boundary dependencies\` is mentioned here.\n\n${badZonesTable}`),
  ),
);
show(
  "1g — the bytes inside a fenced code block stay code (reported)",
  zonesDisagreements(
    inventory.replace(lastZoneRow, `${lastZoneRow}\n\`\`\`\n## Current cross-boundary dependencies\n\`\`\`\n\n${badZonesTable}`),
  ),
);
show(
  "1h — an escaped hash is paragraph text, not a heading (K1.0-SELF-14, reported)",
  zonesDisagreements(
    inventory.replace(lastZoneRow, `${lastZoneRow}\n\\## Current cross-boundary dependencies\n\n${badZonesTable}`),
  ),
);
show(
  "1i — a hash run with no required whitespace is paragraph text (K1.0-SELF-15, reported)",
  zonesDisagreements(
    inventory.replace(lastZoneRow, `${lastZoneRow}\n##Current cross-boundary dependencies\n\n${badZonesTable}`),
  ),
);
show(
  "1j — seven hashes are not a heading (K1.0-SELF-16, reported)",
  zonesDisagreements(
    inventory.replace(lastZoneRow, `${lastZoneRow}\n####### Current cross-boundary dependencies\n\n${badZonesTable}`),
  ),
);
show(
  "1j2 — four-space indented heading bytes are code (K1.0-SELF-16, reported)",
  zonesDisagreements(
    inventory.replace(lastZoneRow, `${lastZoneRow}\n    ## Current cross-boundary dependencies\n\n${badZonesTable}`),
  ),
);
show(
  "1k — a mismatched fence closer leaves the fence open; the table after the matching closer is reported (K1.0-SELF-17)",
  zonesDisagreements(
    inventory.replace(lastZoneRow, `${lastZoneRow}\n\`\`\`\n## Current cross-boundary dependencies\n~~~\n\`\`\`\n\n${badZonesTable}`),
  ),
);
show(
  "1l — a blockquote carrying heading bytes is a quote, not the section heading (reported)",
  zonesDisagreements(
    inventory.replace(lastZoneRow, `${lastZoneRow}\n> ## Current cross-boundary dependencies\n\n${badZonesTable}`),
  ),
);
show(
  "1m — prose before the real heading is outside the section (green)",
  zonesDisagreements(
    inventory.replace("## Zones\n", `See ## Zones below.\n\n${badZonesTable}## Zones\n`),
  ),
);
show(
  "1n — a fenced current-heading mention is code, not the start (green)",
  zonesDisagreements(
    inventory.replace("## Zones\n", `\`\`\`\n## Zones\n\`\`\`\n\n${badZonesTable}## Zones\n`),
  ),
);

console.log("## Stage 2 — table discovery");
show(
  "2a — no header/delimiter pair at all: the governed table is undiscoverable",
  zonesDisagreements(inventory.replace("| Zone id | Roots | Owner and status |\n|---|---|---|\n", "")),
);
show(
  "2b — the delimiter cell count does not match the header (GFM Example 203: no table)",
  zonesDisagreements(inventory.replace("|---|---|---|\n| `target-kernel`", "|---|---|\n| `target-kernel`")),
);
show(
  "2c — a further table in the same section (K1.0-SELF-13)",
  zonesDisagreements(
    inventory.replace(lastZoneRow, `${lastZoneRow}\n| \`target-kernel\` | \`packages/core/src\` | stale |\n|---|---|---|\n`),
  ),
);
show(
  "2d — a fence opened before the first body row: the table breaks and the rows are code",
  zonesDisagreements(
    inventory.replace(
      "|---|---|---|\n| `target-kernel` | `packages/kernel/src`",
      "|---|---|---|\n```\n| `target-kernel` | `packages/kernel/src`",
    ),
  ),
);
show(
  "2e — a fenced block appended after the last body row (renders as code, asserts nothing)",
  zonesDisagreements(inventory.replace(lastZoneRow, `${lastZoneRow}\n\`\`\`\n| \`target-kernel\` | \`packages/core/src\` | code, not a row |\n\`\`\`\n`)),
);
show(
  "2f — a blockquote line inside the body breaks the table (GFM Example 201)",
  zonesDisagreements(
    inventory.replace(lastZoneRow, `> quote breaks the body\n${lastZoneRow}`),
  ),
);

console.log("## Stage 3 — header/delimiter recognition");
show(
  "3a — the structural header does not carry its expected label",
  zonesDisagreements(inventory.replace("| Zone id | Roots | Owner and status |", "| Zone identifier | Roots | Owner and status |")),
);
show(
  "3b — an alignment delimiter is still the delimiter, not a data row (valid variant)",
  zonesDisagreements(inventory.replace("|---|---|---|", "| :--- | ---: | :---: |")),
);
show(
  "3c — a later delimiter-shaped line inside the body is an ordinary row",
  zonesDisagreements(inventory.replace(lastZoneRow, `${lastZoneRow}|---|---|---|\n`)),
);

console.log("## Stage 4 — row splitting");
show(
  "4a — an escaped pipe stays inside its cell (GFM Example 200)",
  zonesDisagreements(
    inventory.replace(
      "| `target-kernel` | `packages/kernel/src` | New Kernel work under the target Activation/Outcome protocol. **Contains no protocol implementation at this revision.** |",
      "| `target-kernel` | `packages/core/src` | stale \\| contradictory duplicate |\n| `target-kernel` | `packages/kernel/src` | New Kernel work under the target Activation/Outcome protocol. **Contains no protocol implementation at this revision.** |",
    ),
  ),
);
show(
  "4b — excess cells beyond the header count (GFM Example 204: not rendered; row still recorded)",
  zonesDisagreements(
    inventory.replace(
      "| `host-sdk` | `packages/sdk/src` | Application bootstrap and host composition. |",
      "| `host-sdk` | `packages/sdk/src` | Application bootstrap and host composition. | extra |",
    ),
  ),
);
show(
  "4c — a pipe-less continuation line is still a row (GFM Example 202)",
  zonesDisagreements(inventory.replace(lastZoneRow, "`target-kernel`\n" + lastZoneRow)),
);

console.log("## Stage 5 — header/body classification (K10-R6-01)");
for (const position of ["before", "after"] as const) {
  const correct =
    "| `target-kernel` | `packages/kernel/src` | New Kernel work under the target Activation/Outcome protocol. **Contains no protocol implementation at this revision.** |";
  const bad = "| Zone id | `packages/core/src` | stale contradictory body row |";
  const mutated =
    position === "before" ? inventory.replace(correct, `${bad}\n${correct}`) : inventory.replace(correct, `${correct}\n${bad}`);
  show(`5 — Zones / Zone id: header-label body row ${position} the correct row`, zonesDisagreements(mutated));
}

console.log("## Stage 6 — key extraction, duplicates, values, propagation, comparison");
show(
  "6a — a row with no recognisable key",
  zonesDisagreements(inventory.replace(lastZoneRow, `${lastZoneRow}| not-a-zone | x | y |\n`)),
);
show(
  "6b — duplicate zone row before the correct row (the after-order twin lives in the committed suite)",
  zonesDisagreements(
    inventory.replace(
      "| `target-kernel` | `packages/kernel/src` |",
      "| `target-kernel` | `packages/core/src` | stale |\n| `target-kernel` | `packages/kernel/src` |",
    ),
  ),
);
show(
  "6c — a short row with a recognisable key fails closed after the key is seen",
  zonesDisagreements(inventory.replace(
    "| `target-kernel` | `packages/kernel/src` |",
    "| `target-kernel` |\n| `target-kernel` | `packages/kernel/src` |",
  )),
);
show(
  "6e — a second backticked token inside the key cell (recorded under the first-token rule)",
  zonesDisagreements(
    inventory.replace(
      "| `target-kernel` | `packages/kernel/src` |",
      "| `target-kernel` `legacy-core` | `packages/kernel/src` |",
    ),
  ),
);
show(
  "6d — two zones' roots swapped (relational, token sets unchanged)",
  zonesDisagreements(
    inventory
      .replace("| `target-kernel` | `packages/kernel/src` |", "| `target-kernel` | `PLACEHOLDER` |")
      .replace("| `legacy-core` | `packages/core/src` |", "| `legacy-core` | `packages/kernel/src` |")
      .replace("| `target-kernel` | `PLACEHOLDER` |", "| `target-kernel` | `packages/core/src` |"),
  ),
);
```

