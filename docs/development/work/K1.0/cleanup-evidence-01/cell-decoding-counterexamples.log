import fs from 'node:fs';
import assert from 'node:assert/strict';
import { pathToFileURL } from 'node:url';
const root = process.cwd();
const load = p => import(pathToFileURL(`${root}/${p}`));
const {parseDependencyTable, parseInventory, inventoryDisagreements} = await load('tests/conformance/architecture/inventory-oracle.ts');
const {loadWorkspace} = await load('tests/conformance/architecture/module-graph.ts');
const {ZONES, DEFERRED_EXTRACTIONS} = await load('tests/conformance/architecture/boundary-policy.ts');
const source = fs.readFileSync('docs/development/work/K1.0/ownership-inventory.md', 'utf8');
const baseline = parseDependencyTable(source);
const workspace = await loadWorkspace(root);
const anchor = '| `target-kernel` | 2 | nothing | nothing |';
assert.equal(source.split(anchor).length - 1, 1);
const mutations = [
  ['baseline', anchor],
  ['fractional count', '| `target-kernel` | 2.5 | nothing | nothing |'],
  ['count with junk suffix', '| `target-kernel` | 2oops | nothing | nothing |'],
  ['mixed empty/workspace claim', '| `target-kernel` | 2 | nothing, `@arrokothi/core` | nothing |'],
  ['mixed empty/external claim', '| `target-kernel` | 2 | nothing | nothing, `evil-package` |'],
];
for (const [name, replacement] of mutations) {
  const changed = source.replace(anchor, replacement);
  const parsed = parseDependencyTable(changed);
  assert.deepEqual(parsed, baseline);
  assert.deepEqual(inventoryDisagreements(parseInventory(changed), {zones: ZONES, deferred: DEFERRED_EXTRACTIONS}, workspace), []);
  const row = parsed.rows.get('target-kernel');
  console.log(JSON.stringify({name, replacement, unreadable: parsed.unreadable, files: row.files, reaches: [...row.reaches], thirdParty: [...row.thirdParty], equalsBaseline: true}));
}
console.log('Confirmed: all four invalid/contradictory cells are indistinguishable from baseline to the existing downstream assertions. Exit 0 confirms the defect, not correctness.');

