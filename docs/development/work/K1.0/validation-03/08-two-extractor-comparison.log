Full source is quoted here so the run is reproducible.

$ node --experimental-strip-types ./k1-0-two-extractor.mjs

--- begin source ---
// Provenance evidence for K1.0-C9: the AST pass and the TypeScript compiler's own file
// pre-processor, compared over the synthetic matrix and every source in the repository. The union
// of the two is what the guards consume; this shows the union is a safety net rather than a crutch
// covering a hole in the AST pass. Output-only evidence; this source is quoted in the log.
import { readFile, readdir } from "node:fs/promises";
import { resolve } from "node:path";
import { astDependencies, preprocessorDependencies } from "./tests/conformance/architecture/module-graph.ts";

const ROOT = process.cwd();
const NL = String.fromCharCode(10);

const MATRIX = [
  'import { a } from "@arrokothi/core";',
  'import type { A } from "@arrokothi/core";',
  'import "@arrokothi/core";',
  'export { a } from "@arrokothi/core";',
  'export * from "@arrokothi/core";',
  'export * as ns from "@arrokothi/core";',
  'export type { A } from "@arrokothi/core";',
  'import A = require("@arrokothi/core");',
  'const m = await import("@arrokothi/core");',
  'export type P = import("@arrokothi/core").X;',
  'export type Q = typeof import("@arrokothi/core");',
  'export type R = ReadonlyArray<import("@arrokothi/core").X>;',
  '/// <reference path="../core/src/x.ts" />',
  '/// <reference types="@arrokothi/core" />',
  'declare module "@arrokothi/core" {}',
].join(NL);

const specifiers = (list) => [...new Set(list.map((d) => d.specifier))].sort();

console.log("Synthetic matrix (15 dependency-bearing forms in one source):");
const matrixAst = specifiers(astDependencies(MATRIX));
const matrixPre = specifiers(preprocessorDependencies(MATRIX));
console.log("  AST pass:          " + JSON.stringify(matrixAst));
console.log("  pre-processor:     " + JSON.stringify(matrixPre));
console.log("  seen only by the pre-processor: " + JSON.stringify(matrixPre.filter((x) => !matrixAst.includes(x))));
console.log("");

const files = [];
for (const d of ["packages", "tests", "examples", "scripts"]) {
  const entries = await readdir(resolve(ROOT, d), { recursive: true });
  files.push(...entries.filter((p) => p.endsWith(".ts") && !p.includes("node_modules")).map((p) => d + "/" + p));
}
files.sort();

let identical = 0;
const astOnly = [];
const preOnly = [];
for (const f of files) {
  const src = await readFile(resolve(ROOT, f), "utf8");
  const a = specifiers(astDependencies(src));
  const p = specifiers(preprocessorDependencies(src));
  const onlyA = a.filter((x) => !p.includes(x));
  const onlyP = p.filter((x) => !a.includes(x));
  if (onlyA.length === 0 && onlyP.length === 0) {
    identical += 1;
    continue;
  }
  for (const x of onlyA) astOnly.push([f, x]);
  for (const x of onlyP) preOnly.push([f, x]);
}

console.log("Repository corpus:");
console.log("  files: " + files.length + "   identical: " + identical);
console.log("  seen only by the AST pass (" + astOnly.length + "):");
for (const [f, x] of astOnly) console.log("    " + f + "  ->  " + JSON.stringify(x));
console.log("  seen only by the pre-processor (" + preOnly.length + "):");
for (const [f, x] of preOnly) console.log("    " + f + "  ->  " + JSON.stringify(x));
console.log("");
console.log("A dependency seen only by the pre-processor would mean the category table in");
console.log("module-graph.ts is incomplete. The suite asserts that count is zero.");
--- end source ---

