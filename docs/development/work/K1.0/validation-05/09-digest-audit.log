$ node --experimental-strip-types ./k1-0-digest-audit.mjs

--- begin source ---
// K10-R4-02 adjacent-path audit: every digest recorded in every K1.0 validation manifest, checked
// for well-formedness and against the file it names. Output-only evidence; source quoted in the log.
import { createHash } from "node:crypto";
import { readFile, readdir } from "node:fs/promises";
import { resolve } from "node:path";

const ROOT = process.cwd();
const WORK = "docs/development/work/K1.0";

const allDirs = (await readdir(resolve(ROOT, WORK), { withFileTypes: true }))
  .filter((e) => e.isDirectory() && e.name.startsWith("validation-"))
  .map((e) => e.name)
  .sort();

// A round whose manifest has not been written yet is a capture in progress: it records no digests,
// so it has none that can be wrong. Reported, then skipped - the same rule the committed
// evidence-records.test.ts applies.
const dirs = [];
const inProgress = [];
for (const d of allDirs) {
  const names = await readdir(resolve(ROOT, WORK, d));
  if (names.includes("MANIFEST.md")) dirs.push(d);
  else inProgress.push(d);
}
if (inProgress.length > 0) console.log("capture in progress, no manifest yet: " + inProgress.join(", ") + String.fromCharCode(10));

let checked = 0;
const problems = [];

for (const dir of dirs) {
  const manifestPath = `${WORK}/${dir}/MANIFEST.md`;
  const manifest = await readFile(resolve(ROOT, manifestPath), "utf8");
  const files = (await readdir(resolve(ROOT, WORK, dir))).filter((f) => f.endsWith(".log")).sort();

  console.log(dir + "  (" + files.length + " logs)");
  for (const file of files) {
    // The manifest row for this log: the last backticked token on its line.
    const line = manifest.split(String.fromCharCode(10)).find((l) => l.includes("](" + file + ")"));
    if (line === undefined) {
      problems.push(dir + "/" + file + ": no manifest row");
      console.log("    " + file.padEnd(34) + "NO MANIFEST ROW");
      continue;
    }
    const tokens = (line.match(/`([0-9a-fA-F]+)`/g) ?? []).map((t) => t.replace(/`/g, ""));
    const recorded = tokens[tokens.length - 1];
    const actual = createHash("sha256").update(await readFile(resolve(ROOT, WORK, dir, file))).digest("hex");
    checked += 1;

    let verdict;
    if (recorded === undefined) {
      verdict = "NO DIGEST RECORDED";
    } else if (recorded.length !== 64) {
      verdict = "NOT SHA-256: " + recorded.length + " hex characters";
    } else if (recorded !== actual) {
      verdict = "MISMATCH: recorded " + recorded;
    } else {
      verdict = "ok";
    }
    if (verdict !== "ok") problems.push(dir + "/" + file + ": " + verdict);
    console.log("    " + file.padEnd(34) + verdict);
  }
}

console.log("");
console.log("digests checked: " + checked + "   problems: " + problems.length);
for (const p of problems) console.log("  " + p);
