/**
 * K10-R15-01 grammar audit: reviewed H15 parser vs candidate C parser vs an INDEPENDENT
 * specification reference.
 *
 * Three columns, not two. `gfm-reference.mts` (quoted in full below) is a transliteration of
 * published GFM 0.29 sentences, written as a left-to-right index walk in the sentences' own
 * order, importing nothing from the parser. Round 15's audit had only a hand-typed expected
 * column and therefore agreed with its own bug; a row where H15 and C agree but the reference
 * differs is now visible.
 *
 * The `rule` column names the sentence that decides the row. The sentences themselves are
 * printed above the table so each rule can be checked against the published text directly.
 */
const REPO = "/Users/rex-shih/Documents/ArrokothI/arrokothi";
const ARCH = `${REPO}/tests/conformance/architecture`;
const H_ORACLE = new URL("./oracle-H15.ts", import.meta.url).pathname;

const H = await import(H_ORACLE);
const C = await import(`${ARCH}/inventory-oracle.ts`);
const { atxReference, tableCellsReference, SPEC } = await import(new URL("./gfm-reference.mts", import.meta.url).pathname);

const NBSP = String.fromCharCode(0x00a0);
const VT = String.fromCharCode(0x000b);
const FF = String.fromCharCode(0x000c);
const IDEO = String.fromCharCode(0x3000);
const ZWNBSP = String.fromCharCode(0xfeff);
const THIN = String.fromCharCode(0x2009);

const show = (value: string | undefined): string =>
  value === undefined ? "(not a heading)" : JSON.stringify(value);
const pad = (text: string, width: number): string =>
  text.length >= width ? text : text + " ".repeat(width - text.length);

const headingOf = (mod: typeof C, line: string): string | undefined =>
  mod.scanBlocks(line)[0]?.heading?.text;

console.log("== GFM 0.29 sentences this audit's reference implements ==");
