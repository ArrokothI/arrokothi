== the reference, quoted in full (it enters no tracked path) ==
--- gfm-reference.mts ---
/**
 * An INDEPENDENT reference normalizer for the two C4 productions, transliterated
 * sentence-by-sentence from published GFM 0.29 (CommonMark 0.29 core + tables extension).
 *
 * This file exists because validation-15/09's "expected" column was hand-typed by the same
 * author who wrote the parser, from the same reading. When that reading was wrong — the §2.1
 * six admitted before an ATX closing hash run — the oracle agreed with the bug and reported
 * "C matches the derived GFM value on all 27 cases". An oracle that restates the
 * implementation's intent cannot detect the implementation's misreading.
 *
 * The mitigation is structural rather than a promise to be more careful:
 *
 *  - every rule below is a transliteration of a quoted specification sentence, printed
 *    beside the code that implements it, so the derivation is auditable against the
 *    published text without reading `inventory-oracle.ts`;
 *  - it is written as a left-to-right index walk over the whole physical line in the
 *    sentences' own order, deliberately not in the parser's shape (which normalises the
 *    substring after the opening sequence), so a shared structural assumption cannot hide;
 *  - it imports nothing from the parser, shares no helper, and is compared against BOTH the
 *    reviewed H15 parser and the candidate C parser, so a row where C agrees with H15 and
 *    both differ from the reference is visible rather than invisible.
 *
 * Residual risk, stated rather than hidden: one author still wrote both, so a misreading of
 * a quoted sentence could still be duplicated. The quotes are printed so that a reviewer can
 * check each rule against the specification directly, which is the part that does not
 * depend on the author.
 */

/** The specification sentences this file implements, verbatim, for the audit to print. */
export const SPEC = {
  // GFM 0.29 §2.1 Characters and lines
  BLANK:
    "§2.1: A line containing no characters, or a line containing only spaces (U+0020) or tabs (U+0009), is called a blank line.",
  WS6:
    "§2.1: A whitespace character is a space (U+0020), tab (U+0009), newline (U+000A), line tabulation (U+000B), form feed (U+000C), or carriage return (U+000D).",
  // GFM 0.29 §2.2 Tabs
  TABS:
    "§2.2: Tabs in lines are not expanded to spaces. However, in contexts where spaces help to define block structure, tabs behave as if they were replaced by spaces with a tab stop of 4 characters.",
  // GFM 0.29 §4.2 ATX headings
  ATX_OPEN:
    "§4.2: An ATX heading consists of a string of characters, parsed as inline content, between an opening sequence of 1-6 unescaped # characters and an optional closing sequence of any number of unescaped # characters.",
  ATX_SEP:
    "§4.2: The opening sequence of # characters must be followed by a space or by the end of line.",
  ATX_CLOSE:
    "§4.2: The optional closing sequence of #s must be preceded by a space and may be followed by spaces only.",
  ATX_INDENT: "§4.2: The opening # character may be indented 0-3 spaces.",
  ATX_STRIP:
    "§4.2: The raw contents of the heading are stripped of leading and trailing spaces before being parsed as inline content.",
  ATX_LEVEL:
    "§4.2: The heading level is equal to the number of # characters in the opening sequence.",
  // GFM 0.29 tables extension
  TABLE_PIPES:
    "tables: The table's rows consist of cells delimited by pipes (|); the leading and trailing pipe characters are optional.",
  TABLE_ESCAPE:
    "tables: Include a pipe in a cell's content by escaping it, including inside other inline spans.",
  TABLE_TRIM:
    "tables: every published example surrounds cell content with spaces and renders it without them; the extension defines no trim over the §2.1 whitespace set.",
} as const;

/**
 * Block-structure whitespace: SPACE and TAB.
 *
 * Derived, not assumed. §4.2 says "space" at the indentation, separator, closing-run
 * predecessor and closing-run follower positions, and "spaces" at the content strip.
 * SPEC.TABS then substitutes TAB for SPACE wherever spaces define block structure, and
 * every one of those five positions does. SPEC.WS6 is a definition used by OTHER
 * productions (§4.6 raw-HTML starts, §6.10 tags); §4.2 never cites it, so VT and FF
 * are not admitted here.
 */
const isSpaceOrTab = (ch: string | undefined): boolean => ch === " " || ch === "\t";

/** One ATX heading per SPEC.ATX_*, as a left-to-right walk in the sentences' own order. */
export function atxReference(line: string): { readonly level: number; readonly text: string } | undefined {
  let i = 0;

  // SPEC.ATX_INDENT + SPEC.TABS: 0-3 columns of indentation; a tab advances to the next
  // stop of 4. Four or more columns is an indented code block, which is not a heading.
  let column = 0;
  while (i < line.length && isSpaceOrTab(line[i])) {
    column += line[i] === " " ? 1 : 4 - (column % 4);
    i++;
  }
  if (column >= 4) return undefined;

  // SPEC.ATX_OPEN + SPEC.ATX_LEVEL: an opening sequence of 1-6 `#`.
  const openStart = i;
  while (i < line.length && line[i] === "#") i++;
  const level = i - openStart;
  if (level < 1 || level > 6) return undefined;

  // SPEC.ATX_SEP: followed by a space (SPEC.TABS: or a tab) or by the end of line.
  if (i < line.length && !isSpaceOrTab(line[i])) return undefined;

  // SPEC.ATX_STRIP: the raw contents are stripped of leading and trailing spaces.
  let contentStart = i;
  while (contentStart < line.length && isSpaceOrTab(line[contentStart])) contentStart++;
  let contentEnd = line.length;
  while (contentEnd > contentStart && isSpaceOrTab(line[contentEnd - 1])) contentEnd--;
  let text = line.slice(contentStart, contentEnd);

  // SPEC.ATX_CLOSE: an optional closing sequence of `#`s, which must be preceded by a space
  // and may be followed by spaces only. The strip above already removed the trailing spaces,
  // so "followed by spaces only" means the run now ends the content; "preceded by a space"
  // means the character before the run is a space or tab, or else the run reaches the start
  // of the content, where SPEC.ATX_SEP guaranteed the separator was a space or tab.
  let runStart = text.length;
  while (runStart > 0 && text[runStart - 1] === "#") runStart--;
  if (runStart !== text.length && (runStart === 0 || isSpaceOrTab(text[runStart - 1]))) {
    text = text.slice(0, runStart);
    // SPEC.ATX_STRIP again: the contents that remain are stripped of trailing spaces.
    while (text.length > 0 && isSpaceOrTab(text[text.length - 1])) text = text.slice(0, -1);
  }

  return { level, text };
}

/** Whether the `|` at `pos` is escaped by an odd run of backslashes (SPEC.TABLE_ESCAPE). */
const escaped = (line: string, pos: number): boolean => {
  let n = 0;
  for (let j = pos - 1; j >= 0 && line[j] === "\\"; j--) n++;
  return n % 2 === 1;
};

/** One table row's cells per SPEC.TABLE_*, independently of the parser's row reader. */
export function tableCellsReference(line: string): string[] {
  // Row indentation is block structure, so SPACE/TAB only (SPEC.TABS); the trailing run is
  // the same class, because SPEC.TABLE_TRIM gives the extension no wider one.
  let from = 0;
  while (from < line.length && isSpaceOrTab(line[from])) from++;
  let to = line.length;
  while (to > from && isSpaceOrTab(line[to - 1])) to--;
  const row = line.slice(from, to);

  // SPEC.TABLE_PIPES: split on unescaped pipes; one leading and one unescaped trailing pipe
  // are optional delimiters rather than cell boundaries.
  const parts: string[] = [];
  let current = "";
  for (let k = 0; k < row.length; k++) {
    if (row[k] === "|" && !escaped(row, k)) {
      parts.push(current);
      current = "";
    } else {
      current += row[k];
    }
  }
  parts.push(current);
  let start = 0;
  let end = parts.length;
  if (row.startsWith("|")) start = 1;
  if (row.endsWith("|") && !escaped(row, row.length - 1)) end = parts.length - 1;

  return parts.slice(start, end).map((cell) => {
    // SPEC.TABLE_ESCAPE, then SPEC.TABLE_TRIM with the block-structure class.
    let value = cell.replace(/\\\|/g, "|");
    while (value.length > 0 && isSpaceOrTab(value[0])) value = value.slice(1);
    while (value.length > 0 && isSpaceOrTab(value[value.length - 1])) value = value.slice(0, -1);
    return value;
  });
}
--- end gfm-reference.mts ---

