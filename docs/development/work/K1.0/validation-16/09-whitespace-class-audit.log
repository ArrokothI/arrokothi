const doc = (row: string): string =>
  `## Deferred extraction and bridge owners\n\n| Id | Current path | Disposition | Owner | Why |\n|---|---|---|---|---|\n${row}\n\n## What this packet does not establish\n`;

/** What the keyed reader makes of one planted row, through the full production path. */
const readRow = (mod: typeof C, row: string): string => {
  const parsed = mod.parseInventory(doc(row));
  const keyed = [...parsed.deferred].map(
    ([id, value]) => `${id} -> {${value.disposition}}`,
  );
  const problems = parsed.unreadable
    .filter((entry) => entry.startsWith("Deferred"))
    .map((entry) => entry.replace(/^Deferred /, "").split(":")[0]!);
  return [...keyed, ...problems].join(" ; ") || "(nothing)";
};

/** What the reference says the same row's first two content cells are. */
const referenceRow = (row: string): string => {
  const cells = tableCellsReference(row);
  return `key=${JSON.stringify(cells[0] ?? "")} disposition=${JSON.stringify(cells[2] ?? "")}`;
};

const rowCases: readonly (readonly [string, string])[] = [
  ["| DX-1 | `p/q.ts` | migratable | K1.1 | why |", "plain row"],
  ["|  \tDX-1\t  | `p/q.ts` |\tmigratable\t| K1.1 | why |", "SPACE/TAB padding is trimmed (TABLE_TRIM + TABS)"],
  [`| DX-1${VT} | \`p/q.ts\` | migratable | K1.1 | why |`, "VT in the key cell is content, so there is no DX key"],
  [`| DX-1${FF} | \`p/q.ts\` | migratable | K1.1 | why |`, "FF analogue"],
  [`| DX-1 | \`p/q.ts\` | ${VT}migratable | K1.1 | why |`, "VT in the value cell is a different disposition token"],
  [`| DX-1 | \`p/q.ts\` | migratable${FF} | K1.1 | why |`, "FF analogue, trailing"],
  [`| DX-1${NBSP} | \`p/q.ts\` | migratable | K1.1 | why |`, "the closed U+00A0 case, preserved"],
  [`${VT}| DX-1 | \`p/q.ts\` | migratable | K1.1 | why |`, "VT indentation is not block structure: no leading edge pipe"],
  ["   | DX-1 | `p/q.ts` | migratable | K1.1 | why |", "three spaces of indentation is block structure"],
  ["| DX-1 | `p/q.ts` | migratable | K1.1 | why |   ", "trailing spaces are stripped"],
  [`| DX-1 | \`p/q.ts\` | migratable | K1.1 | why |${VT}`, "a VT after the final pipe is a further cell, not padding"],
];

console.log(pad("row", 54), pad("reference cells", 44), pad("H15 keyed", 30), pad("C keyed", 30), " note");
console.log("-".repeat(190));
let rowDisagreements = 0;
for (const [row, note] of rowCases) {
  const h = readRow(H, row);
  const c = readRow(C, row);
  if (h !== c) rowDisagreements++;
  console.log(pad(JSON.stringify(row), 54), pad(referenceRow(row), 44), pad(h, 30), pad(c, 30), (h === c ? "  " : "! "), note);
}
console.log("-".repeat(190));
console.log(`row cases ${rowCases.length}; H15 != C on ${rowDisagreements}`);
console.log("A reference key that is not exactly DX-n must reach the reader as a row with no");
console.log("recognisable key; a reference disposition that is not exactly the policy token must");
console.log("reach it as a disagreement. Read each C column against the reference cells beside it.");

// ---------------------------------------------------------------------------
// Non-vacuity: the reference is not a toy that only answers the matrix. Run it over every
// physical line of the real governed document and require it to agree with C line for line,
// both on which lines are headings and on their exact content.
console.log("");
console.log("== Non-vacuity: reference vs C over every line of the real inventory ==");
console.log("");
const { readFile } = await import("node:fs/promises");
const inventory = await readFile(`${REPO}/docs/development/work/K1.0/ownership-inventory.md`, "utf8");
const lines = inventory.split(/\r\n|\r|\n/);
const annotated = C.scanBlocks(inventory);
let headings = 0;
let mismatches = 0;
for (let i = 0; i < lines.length; i++) {
  const want = atxReference(lines[i]!);
  const got = annotated[i]?.heading;
  if (want !== undefined) headings++;
  const same = (want?.level ?? null) === (got?.level ?? null) && (want?.text ?? null) === (got?.text ?? null);
  if (!same) {
    mismatches++;
    console.log(`  line ${i + 1}: reference ${JSON.stringify(want)} vs C ${JSON.stringify(got)} for ${JSON.stringify(lines[i])}`);
  }
}
console.log(`  ${lines.length} physical lines; ${headings} ATX headings found by the reference; ${mismatches} mismatches against C`);
if (mismatches !== 0) process.exitCode = 1;

if (cWrong !== 0) process.exitCode = 1;
