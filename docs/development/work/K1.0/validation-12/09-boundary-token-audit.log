/**
 * Validation-12/09: type-6 boundary token audit for K10-R11-01.
 *
 * Shows the corrected start-condition directly: each window prints one row per physical
 * line with fence/HTML state (including the html kind @ depth), structural classification,
 * and heading/table eligibility. C is the committed production parser imported from its
 * real path. The neighbor audit (types 1 and 7) is included in the same windows.
 * Each opener runs in its own window so no raw block leaks into the next case.
 */
import { scanTransitions } from "/Users/rex-shih/Documents/ArrokothI/arrokothi/tests/conformance/architecture/inventory-oracle.ts";

const show = (title: string, doc: string): void => {
  const lines = doc.split("\n");
  const tr = scanTransitions(doc);
  console.log(`--- ${title} (${lines.length} lines, ${tr.length} transitions, equal=${lines.length === tr.length})`);
  for (const t of tr) {
    console.log(
      `L${t.index} d${t.depthBefore}->d${t.depthAfter}${t.containers === null ? "" : `(${t.containers})`} ` +
      `fb=${t.fenceBefore} hb=${t.htmlBefore} => ${t.classification} ` +
      `fa=${t.fenceAfter} ha=${t.htmlAfter}` +
      `${t.containerClosedLeaf ? " CLOSED-BY-CONTAINER" : ""} head=${t.headingAllowed ? "Y" : "-"} tab=${t.tableAllowed ? "Y" : "-"} | ${JSON.stringify(t.text.slice(0, 60))}`,
    );
  }
};

show("A lone slash stays ordinary; heading eligible", ["<div/ x>", "## What this packet does not establish"].join("\n"));
show("B slash-name stays ordinary", ["<div/foo>", "## What this packet does not establish"].join("\n"));
show("B2 bare slash stays ordinary", ["<div/", "## What this packet does not establish"].join("\n"));
show("C literal dollar stays ordinary", ["<div$foo>", "## What this packet does not establish"].join("\n"));
show("D1 <div/> opens type 6", ["<div/>", "## What this packet does not establish"].join("\n"));
show("D2 <div> opens type 6", ["<div>", "## What this packet does not establish"].join("\n"));
show("D3 <div class=x> opens type 6", ["<div class=x>", "## What this packet does not establish"].join("\n"));
show("D4 bare <div at EOL opens type 6", ["<div", "## What this packet does not establish"].join("\n"));
show("E1 closing </div> opens type 6", ["</div>", "## What this packet does not establish"].join("\n"));
show("E2 closing </div/> opens type 6", ["</div/>", "## What this packet does not establish"].join("\n"));
show("F prefix without boundary stays ordinary", ["<divfoo> trailing prose", "## What this packet does not establish"].join("\n"));
show("F2 complete custom tag still type 7", ["<divfoo>", "## What this packet does not establish"].join("\n"));
show("G1 type 1 <script> opens", ["<script>", "## What this packet does not establish"].join("\n"));
show("G2 <script/> stays ordinary (type 1 needs space/>/EOL, type 7 excludes script)", ["<script/>", "## What this packet does not establish"].join("\n"));
show("G3 mixed-case attributed script still type 1", ["<SCRIPT type=\"text/javascript\">", "## What this packet does not establish"].join("\n"));
show("H1 search trailing stays ordinary", ["<search> trailing prose", "## What this packet does not establish"].join("\n"));
show("H2 complete search alone still type 7", ["<search>", "## What this packet does not establish"].join("\n"));
show("H3 missing-whitespace stays ordinary", ["<a href='bar'title=title>", "## What this packet does not establish"].join("\n"));

import { readFile } from "node:fs/promises";
const real = await readFile("/Users/rex-shih/Documents/ArrokothI/arrokothi/docs/development/work/K1.0/ownership-inventory.md", "utf8");
const tr = scanTransitions(real);
console.log(`--- I clean-document spot check (${tr.length} transitions for ${real.split("\n").length} lines, equal=${tr.length === real.split("\n").length})`);
console.log(`containerClosedLeaf ever true: ${tr.some((t) => t.containerClosedLeaf)}`);
