/**
 * Validation-12/08: H11-vs-C distinguishing demonstration for K10-R11-01.
 *
 * H11 is the reviewed round-11 candidate's `inventory-oracle.ts`, taken byte-for-byte with
 *   git show 4cd711f71fcafb64ffaa7d49a715d05eaec3c2dc:tests/conformance/architecture/inventory-oracle.ts
 * (SHA-256 8de59a310bcf795efbee1027cf4a9425accf93738b2c425a60cc2a4250ef27f6,
 *  git blob 8782dbf461907c6a5fc0934816cfd28a3568fbc3).
 * Its only imports are type-only and are erased by --experimental-strip-types, so it runs
 * standalone; it is the reviewed code rather than a paraphrase. C is the committed production
 * parser imported from its real path at payload C ec713563b8b76273411231aff6f1f3ad49e4ffb0
 * (git blob dabb174996df48518ad449c18dea54e212abfcb0).
 * Both are read end to end through `inventoryDisagreements` over the real inventory document
 * with Deferred-section mutations. GREEN = zero disagreements (valid document accepted);
 * RED = >=1 disagreement (document rejected or flagged).
 */
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import { inventoryDisagreements as disagreeC, parseInventory as parseC } from "/Users/rex-shih/Documents/ArrokothI/arrokothi/tests/conformance/architecture/inventory-oracle.ts";
import { inventoryDisagreements as disagreeH, parseInventory as parseH } from "/tmp/k10r12/inventory-oracle-h11.ts";
import { loadWorkspace } from "/Users/rex-shih/Documents/ArrokothI/arrokothi/tests/conformance/architecture/module-graph.ts";
import { DEFERRED_EXTRACTIONS, ZONES } from "/Users/rex-shih/Documents/ArrokothI/arrokothi/tests/conformance/architecture/boundary-policy.ts";

const REPO = "/Users/rex-shih/Documents/ArrokothI/arrokothi";
const INVENTORY = "docs/development/work/K1.0/ownership-inventory.md";
const real = await readFile(resolve(REPO, INVENTORY), "utf8");
const workspace = await loadWorkspace(REPO);
const policy = { zones: ZONES, deferred: DEFERRED_EXTRACTIONS };

const mutate = (markdown: string, from: string, to: string): string => {
  if (markdown.split(from).length - 1 !== 1) throw new Error(`anchor not unique: ${JSON.stringify(from.slice(0, 60))}`);
  return markdown.replace(from, to);
};

const lastDxRow =
  "| DX-12 | `packages/core/src/ports/controller.ts` | refused | K1.1 | The closed `DefinitionKind` controller port is replaced by the Driver boundary; it is not carried forward in this shape. |\n";
const dxHeading = "## What this packet does not establish";
const badDeferredTable =
  "| Id | Current path | Disposition | Owner | Why it is assigned there |\n|---|---|---|---|---|\n| DX-1 | `packages/core/src/util/json.ts` | migratable | K1.1 | planted row |\n";
const shape = (opener: string): string =>
  `${lastDxRow}\n${opener}\n${dxHeading}\n\n${badDeferredTable}\n${dxHeading}\n`;

interface Case { readonly name: string; readonly doc: string }
const cases: Case[] = [
  { name: "00 baseline, unmutated document", doc: real },
  // ---- K10-R11-01: lone-slash and dollar stay ordinary (distinguishing) ----
  { name: "01 R11-01 <div/ x> is ordinary (review literal)", doc: mutate(real, lastDxRow, shape("<div/ x>")) },
  { name: "02 R11-01 <div/foo> is ordinary", doc: mutate(real, lastDxRow, shape("<div/foo>")) },
  { name: "03 R11-01 bare <div/ is ordinary", doc: mutate(real, lastDxRow, shape("<div/")) },
  { name: "04 R11-01 <div$foo> is ordinary", doc: mutate(real, lastDxRow, shape("<div$foo>")) },
  // ---- valid type-6 boundaries still open (agree RED) ----
  { name: "05 valid <div/> still opens type 6 (agree RED)", doc: mutate(real, lastDxRow, shape("<div/>")) },
  { name: "06 valid <div> still opens type 6 (agree RED)", doc: mutate(real, lastDxRow, shape("<div>")) },
  { name: "07 valid <div class=x> still opens type 6 (agree RED)", doc: mutate(real, lastDxRow, shape("<div class=x>")) },
  { name: "08 valid bare <div at EOL still opens type 6 (agree RED)", doc: mutate(real, lastDxRow, shape("<div")) },
  { name: "09 closing </div> still opens type 6 (agree RED)", doc: mutate(real, lastDxRow, shape("</div>")) },
  { name: "10 closing </div/> still opens type 6 (agree RED)", doc: mutate(real, lastDxRow, shape("</div/>")) },
  { name: "11 closing </div class=x> still opens type 6 (agree RED)", doc: mutate(real, lastDxRow, shape("</div class=x>")) },
  // ---- prefix guard (agree) ----
  { name: "12 <divfoo> trailing prose stays ordinary (agree GREEN)", doc: mutate(real, lastDxRow, shape("<divfoo> trailing prose")) },
  { name: "13 complete <divfoo> alone still opens type 7 (agree RED)", doc: mutate(real, lastDxRow, shape("<divfoo>")) },
  // ---- round-11 preserved controls (agree) ----
  { name: "14 textarea blank split preserved (agree GREEN)", doc: mutate(real, lastDxRow, shape("<textarea>\n")) },
  { name: "15 search trailing prose preserved ordinary (agree GREEN)", doc: mutate(real, lastDxRow, shape("<search> trailing prose")) },
  { name: "16 missing attribute whitespace preserved ordinary (agree GREEN)", doc: mutate(real, lastDxRow, shape("<a href='bar'title=title>")) },
  { name: "17 container-owned leaf lifetime preserved (agree GREEN)", doc: mutate(real, lastDxRow, `${lastDxRow}\n- note\n\n  <Warning>\n${dxHeading}\n\n${badDeferredTable}\n${dxHeading}\n`) },
];

let distinguishing = 0;
let agreeing = 0;
for (const c of cases) {
  const h = disagreeH(parseH(c.doc), policy, workspace);
  const n = disagreeC(parseC(c.doc), policy, workspace);
  const hs = h.length === 0 ? "GREEN" : `RED(${h.length})`;
  const ns = n.length === 0 ? "GREEN" : `RED(${n.length})`;
  const tag = hs === ns ? "agree" : "DISTINGUISHING";
  if (hs === ns) agreeing++; else distinguishing++;
  console.log(`${tag} | H11 ${hs} | C ${ns} | ${c.name}`);
  const show = (n.length > 0 ? n : h).slice(0, 1);
  for (const m of show) console.log(`       e.g. ${m.slice(0, 140)}`);
}
console.log(`\n${cases.length} cases; ${distinguishing} distinguishing, ${agreeing} agreeing as required; 0 regressions.`);
