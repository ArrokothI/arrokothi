$ node --experimental-strip-types ./k10-compare-tmp.mts

--- begin source ---
// Compares the pre-K1.0 raw-text scanner with the K10-R1-01 TypeScript-parser scanner,
// over every .ts file in the tree. Output-only evidence: it introduces no script, fixture,
// threshold or configuration into the candidate, and it reads the committed scanner rather
// than reimplementing it.
import { readFile, readdir } from "node:fs/promises";
import { resolve } from "node:path";
import { importSpecifiersIn } from "./tests/conformance/architecture/module-graph.ts";

const ROOT = process.cwd();
// The exact regex removed from tests/conformance/architecture/kernel-boundaries.test.ts at base.
const OLD = /(?:\bfrom\s*|\bimport\s*\(\s*|\bimport\s*)["']([^"']+)["']/g;
const oldSpecifiers = (s: string) => [...s.matchAll(OLD)].map((m) => m[1]);

const files: string[] = [];
for (const dir of ["packages", "tests", "examples", "scripts"]) {
  const entries = await readdir(resolve(ROOT, dir), { recursive: true });
  files.push(...entries.filter((p) => p.endsWith(".ts") && !p.includes("node_modules")).map((p) => `${dir}/${p}`));
}
files.sort();

let identical = 0;
const droppedByNew: [string, string][] = [];
const addedByNew: [string, string][] = [];
for (const file of files) {
  const source = await readFile(resolve(ROOT, file), "utf8");
  const before = new Set(oldSpecifiers(source));
  const after = new Set(importSpecifiersIn(source));
  const dropped = [...before].filter((x) => !after.has(x));
  const added = [...after].filter((x) => !before.has(x));
  if (dropped.length === 0 && added.length === 0) { identical += 1; continue; }
  for (const x of dropped) droppedByNew.push([file, x]);
  for (const x of added) addedByNew.push([file, x]);
}

console.log(`files scanned: ${files.length}`);
console.log(`identical results: ${identical}`);
console.log(`\nreported by the OLD scanner and not by the new one (${droppedByNew.length}):`);
for (const [f, x] of droppedByNew) console.log(`  ${f}\n    ${JSON.stringify(x).slice(0, 160)}`);
console.log(`\nreported by the NEW scanner and not by the old one (${addedByNew.length}):`);
for (const [f, x] of addedByNew) console.log(`  ${f}\n    ${JSON.stringify(x)}`);
--- end source ---

