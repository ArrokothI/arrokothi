// K10-R5-01 demonstrated: valid GFM rows with omitted edge pipes against the H5
// row-discovery front door and the committed one. Output-only evidence; source quoted in log.
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import { parseInventory, parseDependencyTable, inventoryDisagreements } from "./tests/conformance/architecture/inventory-oracle.ts";
import { loadWorkspace } from "./tests/conformance/architecture/module-graph.ts";
import { ZONES, DEFERRED_EXTRACTIONS } from "./tests/conformance/architecture/boundary-policy.ts";

const ROOT = process.cwd();
const INVENTORY = "docs/development/work/K1.0/ownership-inventory.md";
const original = await readFile(resolve(ROOT, INVENTORY), "utf8");
const workspace = await loadWorkspace(ROOT);
const policy = { zones: ZONES, deferred: DEFERRED_EXTRACTIONS };

// The H5 front door, quoted from tests/conformance/architecture/inventory-oracle.ts at
// 2b274e6ecbaa8cdcc4600d8574234fc027c2b37e (reviewed H5). readKeyedTable at H5 is identical
// to the committed one; only this front door changes, so row-discovery counts decide silence.
function h5TableRows(markdown, heading, nextHeading) {
  const section = markdown.split(heading)[1]?.split(nextHeading)[0] ?? "";
  const rows = [];
  for (const line of section.split("\n")) {
    const trimmed = line.trim();
    if (!trimmed.startsWith("|") || !trimmed.endsWith("|")) continue;
    const cells = trimmed.slice(1, -1).split("|").map((cell) => cell.trim());
    if (cells.every((cell) => /^-+$/.test(cell))) continue;
    rows.push(cells);
  }
  return rows;
}
const h5Discovers = (mutated, heading, next, badLine) => {
  const rows = h5TableRows(mutated, heading, next);
  // Does the bad line's key appear among discovered rows? Join cells to search for its marker.
  const marker = badLine.includes("packages/core/src") ? "packages/core/src" : badLine.includes("stale") ? "stale" : badLine.slice(0, 20);
  return rows.some((cells) => cells.join(" | ").includes("stale contradictory duplicate") || cells.join(" | ").includes(marker));
};

const zonesCorrect = "| `target-kernel` | `packages/kernel/src` | New Kernel work under the target Activation/Outcome protocol. **Contains no protocol implementation at this revision.** |";
const reviewBad = "| `target-kernel` | `packages/core/src` | stale contradictory duplicate"; // review-05 literal: no trailing pipe

console.log("Review-05 literal counterexample (Zones, omitted trailing pipe, before correct row):");
{
  const mutated = original.replace(zonesCorrect, reviewBad + "\n" + zonesCorrect);
  const h5sees = h5TableRows(mutated, "## Zones", "## Current cross-boundary").some((c) => c.join(" | ").includes("stale contradictory duplicate"));
  const parsed = parseInventory(mutated);
  const disag = inventoryDisagreements(parsed, policy, workspace);
  console.log(`  H5 row-discovery sees bad row: ${h5sees} (expected false = silent)`);
  console.log(`  H5-equivalent disagreements: 0 (by construction: bad row never reaches readKeyedTable)`);
  console.log(`  committed unreadable: ${parsed.unreadable.length}, disagreements: ${disag.length}`);
  console.log(`  committed first disagreement: ${disag[0] ?? "(none)"}`);
}

console.log("");
console.log("Full edge-pipe matrix through the committed production parser (each before/after correct row):");
const matrix = [
  { table: "Zones", heading: "## Zones", next: "## Current cross-boundary", correct: zonesCorrect,
    bads: { "trailing": "| `target-kernel` | `packages/core/src` | stale contradictory duplicate", "leading": "`target-kernel` | `packages/core/src` | stale contradictory duplicate |", "both": "`target-kernel` | `packages/core/src` | stale contradictory duplicate" },
    check: (m) => inventoryDisagreements(parseInventory(m), policy, workspace).some((x) => /duplicate Zones row for zone target-kernel/.test(x)) },
  { table: "Deferred", heading: "## Deferred extraction", next: "## What this packet",
    correct: "| DX-1 | `packages/core/src/util/hash.ts` | migratable | K1.1 | First packet that needs stable identity/receipt hashing. |",
    bads: { "trailing": "| DX-1 | `packages/core/src/util/json.ts` | migratable | K1.1 | stale contradictory duplicate", "leading": "DX-1 | `packages/core/src/util/json.ts` | migratable | K1.1 | stale contradictory duplicate |", "both": "DX-1 | `packages/core/src/util/json.ts` | migratable | K1.1 | stale contradictory duplicate" },
    check: (m) => inventoryDisagreements(parseInventory(m), policy, workspace).some((x) => /duplicate Deferred row for DX-1/.test(x)) },
  { table: "Export", heading: "## Export ownership", next: "## What the target zone may import",
    correct: "| `@arrokothi/kernel` | `.` | No (private) |",
    bads: { "trailing": "| `@arrokothi/kernel` | `.` | Yes", "leading": "`@arrokothi/kernel` | `.` | Yes |", "both": "`@arrokothi/kernel` | `.` | Yes" },
    check: (m) => inventoryDisagreements(parseInventory(m), policy, workspace).some((x) => /duplicate Export row for package @arrokothi\/kernel/.test(x)) },
  { table: "Dependency", heading: "## Current cross-boundary", next: "## Export ownership",
    correct: "| `target-kernel` | 2 | nothing | nothing |",
    bads: { "trailing": "| `target-kernel` | 999 | `@arrokothi/core` | nothing", "leading": "`target-kernel` | 999 | `@arrokothi/core` | nothing |", "both": "`target-kernel` | 999 | `@arrokothi/core` | nothing" },
    check: (m) => parseDependencyTable(m).unreadable.some((x) => /duplicate Dependency row for zone target-kernel/.test(x)) },
];
for (const row of matrix) {
  for (const [edge, bad] of Object.entries(row.bads)) {
    for (const pos of ["before", "after"]) {
      const mutated = pos === "before" ? original.replace(row.correct, bad + "\n" + row.correct) : original.replace(row.correct, row.correct + "\n" + bad);
      const h5sees = h5TableRows(mutated, row.heading, row.next).some((c) => c.join(" | ").includes("stale contradictory duplicate") || c.join(" | ").includes("999"));
      const flagged = row.check(mutated);
      console.log(`  ${row.table} omitted-${edge} ${pos}: H5 sees=${h5sees} committed flagged=${flagged}`);
    }
  }
}
console.log("");
console.log("Challenger not named by the reviewer (GFM Example 202 pipe-less continuation):");
{
  const pipeless = "`target-kernel`";
  for (const pos of ["before", "after"]) {
    const mutated = pos === "before" ? original.replace(zonesCorrect, pipeless + "\n" + zonesCorrect) : original.replace(zonesCorrect, zonesCorrect + "\n" + pipeless);
    const h5sees = h5TableRows(mutated, "## Zones", "## Current cross-boundary").some((c) => c.join(" | ").includes("`target-kernel`") && c.length === 1 && c[0] === "`target-kernel`");
    // H5 requires edge pipes, so the bare line is never discovered; count pipe-less discovery explicitly:
    const h5discoversPipeless = h5TableRows(mutated, "## Zones", "## Current cross-boundary").length;
    const parsed = parseInventory(mutated);
    console.log(`  pipe-less ${pos}: H5 discovered rows=${h5discoversPipeless} (pipeless line absent), committed unreadable=${parsed.unreadable.length} (${parsed.unreadable[0] ?? "none"})`);
  }
}
console.log("");
console.log("Baseline (unmutated document) stays green on the committed parser:");
{
  const parsed = parseInventory(original);
  const disag = inventoryDisagreements(parsed, policy, workspace);
  const dep = parseDependencyTable(original);
  console.log(`  unreadable=${parsed.unreadable.length} disagreements=${disag.length} depUnreadable=${dep.unreadable.length}`);
}
