show("2", "a blockquote line inside the body breaks the table (GFM Example 201)",
  mut(real, zC, "> | `target-kernel` | `packages/core/src` | quoted |\n" + zC));

console.log("\n## Stage 3 — header/delimiter recognition");
show("3", "the structural header does not carry its expected label",
  mut(real, "| Zone id | Roots | Owner and status |", "| Zone identifier | Roots | Owner and status |"));
show("3", "an alignment delimiter is still the delimiter, not a data row (valid variant)",
  mut(real, "| Zone id | Roots | Owner and status |\n|---|---|---|", "| Zone id | Roots | Owner and status |\n| :--- | ---: | :---: |"));
show("3", "a later delimiter-shaped line inside the body is an ordinary row",
  mut(real, zC, "|---|---|---|\n" + zC));

console.log("\n## Stage 4 — row splitting");
show("4", "an escaped pipe stays inside its cell (GFM Example 200)",
  mut(real, zC, "| `target-kernel` | `packages/core/src` | stale \\| duplicate |\n" + zC));
show("4", "excess cells beyond the header count (GFM Example 204: not rendered; row still recorded)",
