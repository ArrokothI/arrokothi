/**
 * 09 — the silent-exit audit, executed rather than asserted.
 *
 * Every branch in the C4 row pipeline that can end a row's life is driven with an input that
 * actually reaches it, against the committed production parser, and its whole observable result is
 * printed. A branch is legitimate only when the material it drops is structurally not part of the
 * governed table; anything else must come back as a message.
 */
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import { parseInventory, parseDependencyTable, inventoryDisagreements } from "/Users/rex-shih/Documents/ArrokothI/arrokothi/tests/conformance/architecture/inventory-oracle.ts";
import { ZONES, DEFERRED_EXTRACTIONS } from "/Users/rex-shih/Documents/ArrokothI/arrokothi/tests/conformance/architecture/boundary-policy.ts";
import { loadWorkspace } from "/Users/rex-shih/Documents/ArrokothI/arrokothi/tests/conformance/architecture/module-graph.ts";

const ROOT = "/Users/rex-shih/Documents/ArrokothI/arrokothi";
const real = await readFile(resolve(ROOT, "docs/development/work/K1.0/ownership-inventory.md"), "utf8");
const ws = await loadWorkspace(ROOT);
const policy = { zones: ZONES, deferred: DEFERRED_EXTRACTIONS };
const mut = (m: string, f: string, t: string): string => {
  if (m.split(f).length - 1 !== 1) throw new Error(`anchor not unique: ${f}`);
  return m.replace(f, t);
};
const say = (d: string): string[] => [
  ...inventoryDisagreements(parseInventory(d), policy, ws),
  ...parseDependencyTable(d).unreadable,
];
const zC = "| `target-kernel` | `packages/kernel/src` | New Kernel work under the target Activation/Outcome protocol. **Contains no protocol implementation at this revision.** |";
const lastZone = "| `host-sdk` | `packages/sdk/src` | Application bootstrap and host composition. |";

const show = (stage: string, branch: string, doc: string): void => {
  const messages = say(doc);
  console.log(`\n### ${stage} — ${branch}`);
  console.log(messages.length === 0 ? "  (no message)" : messages.map((m) => `  - ${m}`).join("\n"));
};

console.log("## Stage 1 — section selection");
show("1", "the section heading itself is absent", mut(real, "## Zones", "## Ownership zones"));
show("1", "the next heading is absent, so the section runs on into the following table",
  mut(real, "## What the target zone may import", "## Import rules for the target zone"));
