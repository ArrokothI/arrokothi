diff --git a/tests/tooling/value-cost-probe.mjs b/tests/tooling/value-cost-probe.mjs
new file mode 100644
index 00000000..0fe434c4
--- /dev/null
+++ b/tests/tooling/value-cost-probe.mjs
@@ -0,0 +1,98 @@
+// K1.1-correction-03 registry probe (tests/fixtures/packet-tools/value-cost.json): runs the named
+// maintained tests of one case and reports one JSON observation.
+//
+// Evidence contract (review 01, KC3-R1-EVID-02; design 02 §1.2). A kill needs a reached qualifying
+// assertion: a selected test ran in a process that loaded and completed, and it failed with
+// `testCodeFailure` whose cause is an `AssertionError` thrown by an assertion function that a test-side
+// module imported (`value-cost-witness.mjs`). Exactly one state is reported per run:
+//
+//   passed            a selected test ran, every one passed, nothing failed, exit 0     -> exit 0
+//   assertion_failed  a selected test failed at a witnessed assertion                    -> exit 17, reached
+//   no_selection      the run completed and no selected test ran                         -> exit 17, unreached
+//   anything else     spawn_error, output_limit, parse_error, load_error, setup_error,   -> exit 3
+//                     hook_failure, cancelled, test_timeout, subject_exception,
+//                     unattributed_failure
+//
+// Exit 3 is neither 0 nor the case's failure_exit, so TOOLS-01's parser refuses the observation and the
+// runner records a non-credit `setup_error`; this JSON, which the runner keeps, names the precise state.
+// The probe sets no timeout of its own: the runner's case timeout kills the process group and records
+// `timeout`. The assertions live in the maintained test files only.
+import { spawnSync } from 'node:child_process';
+import { mkdtempSync, readFileSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+const NONQUALIFYING_EXIT = 3;
+const id = process.argv[2];
+const entry = JSON.parse(readFileSync('tests/fixtures/packet-tools/value-cost.json', 'utf8')).cases.find((row) => row.id === id);
+const { file, pattern } = entry.input;
+const innerOutput = entry.input.inner_output_bytes ?? 64 * 1024 * 1024;
+const side = mkdtempSync(join(tmpdir(), 'value-cost-probe-'));
+const events = join(side, 'events.jsonl');
+const load = join(side, 'load.json');
+
+const run = spawnSync(process.execPath, [
+  '--experimental-strip-types', '--no-warnings',
+  '--import', './tests/tooling/value-cost-witness.mjs',
+  '--test-reporter=./tests/tooling/value-cost-reporter.mjs', `--test-reporter-destination=${events}`,
+  `--test-name-pattern=${pattern}`, file,
+], { encoding: 'utf8', maxBuffer: innerOutput, env: { ...process.env, ARROKOTHI_VALUE_COST_LOAD: load } });
+
+const readLines = (path) => {
+  try {
+    return readFileSync(path, 'utf8').split('\n').filter((line) => line !== '').map((line) => JSON.parse(line));
+  } catch {
+    return null;
+  }
+};
+const readJson = (path) => {
+  try {
+    return JSON.parse(readFileSync(path, 'utf8'));
+  } catch {
+    return null;
+  }
+};
+const lines = readLines(events);
+const loadFailure = readJson(load);
+rmSync(side, { recursive: true, force: true });
+
+const bounded = (list) => list.slice(0, 20);
+const leaf = (line) => line.type === 'test';
+const executed = (lines ?? []).filter((line) => (line.event === 'pass' || line.event === 'fail') && leaf(line) && !line.skip && !line.todo);
+const witnessed = executed.filter((line) => line.event === 'fail' && line.failureType === 'testCodeFailure' && line.witnessed !== null);
+// A suite (or a test with subtests) fails with `subtestsFailed` because a child did; that is not a failure of its own.
+const failures = (lines ?? []).filter((line) => line.event === 'fail' && line.failureType !== 'subtestsFailed');
+const nonqualifying = failures.filter((line) => !witnessed.includes(line));
+const summary = (lines ?? []).find((line) => line.event === 'summary');
+const started = (lines ?? []).some((line) => line.event === 'start');
+
+let state;
+if (run.error !== undefined) state = run.error.code === 'ENOBUFS' ? 'output_limit' : 'spawn_error';
+else if (lines === null || summary === undefined) state = started ? 'setup_error' : loadFailure?.syntax === true ? 'parse_error' : loadFailure !== null ? 'load_error' : 'setup_error';
+else if (witnessed.length > 0) state = 'assertion_failed';
+else if (executed.length === 0 && failures.length === 0) state = 'no_selection';
+else if (failures.length === 0 && run.status === 0 && run.signal === null) state = 'passed';
+else {
+  const first = nonqualifying[0];
+  state = first === undefined ? 'unattributed_failure'
+    : first.failureType === 'hookFailed' ? 'hook_failure'
+    : first.failureType === 'cancelledByParent' ? 'cancelled'
+    : first.failureType === 'testTimeoutFailure' ? 'test_timeout'
+    : first.failureType === 'testCodeFailure' && leaf(first) ? 'subject_exception'
+    : 'unattributed_failure';
+}
+
+const reached = state === 'passed' || state === 'assertion_failed';
+const passed = state === 'passed';
+const exit = state === 'passed' ? 0 : state === 'assertion_failed' || state === 'no_selection' ? entry.failure_exit : NONQUALIFYING_EXIT;
+const named = state === 'assertion_failed'
+  ? bounded(witnessed.map((line) => `${file} > ${line.name} [${line.witnessed}]`))
+  : state === 'passed' ? [] : [`${entry.assertion}: ${state}`];
+console.log(JSON.stringify({
+  case: id, assertion: entry.assertion, reached, passed, state,
+  leaves: executed.length, pass: executed.filter((line) => line.event === 'pass').length, fail: executed.filter((line) => line.event === 'fail').length,
+  failures: named,
+  nonqualifying: bounded(nonqualifying.map((line) => ({ name: line.name, type: line.type, failureType: line.failureType, cause: line.cause }))),
+  load: loadFailure, status: run.status, signal: run.signal, claim: entry.claim,
+}));
+process.exitCode = exit;
diff --git a/tests/tooling/value-cost-reporter.mjs b/tests/tooling/value-cost-reporter.mjs
new file mode 100644
index 00000000..0d266e34
--- /dev/null
+++ b/tests/tooling/value-cost-reporter.mjs
@@ -0,0 +1,36 @@
+// K1.1-correction-03 review 01 (KC3-R1-EVID-02): the value-cost probe's test reporter.
+//
+// It writes one JSON line per finished test or suite and one for the run summary. For a failure it records
+// the failure type and whether its cause is an assertion error that `value-cost-witness.mjs` saw a
+// test-side assertion function throw. The reporter and the tests run in one process, so the cause is the
+// thrown object itself. A run that never loads produces no line at all.
+const WITNESS = Symbol.for('arrokothi.value-cost.witness');
+const bounded = (text) => (typeof text === 'string' ? text.slice(0, 200) : null);
+
+export default async function* valueCostReporter(source) {
+  const witnessed = globalThis[WITNESS];
+  for await (const event of source) {
+    const data = event.data ?? {};
+    if (event.type === 'test:start') {
+      yield `${JSON.stringify({ event: 'start', name: bounded(data.name), nesting: data.nesting })}\n`;
+    } else if (event.type === 'test:pass' || event.type === 'test:fail') {
+      const details = data.details ?? {};
+      const error = details.error;
+      const cause = error?.cause;
+      const witness = cause !== null && typeof cause === 'object' && witnessed instanceof WeakMap ? witnessed.get(cause) : undefined;
+      yield `${JSON.stringify({
+        event: event.type === 'test:pass' ? 'pass' : 'fail',
+        name: bounded(data.name),
+        nesting: data.nesting,
+        type: details.type ?? null,
+        skip: data.skip !== undefined && data.skip !== false,
+        todo: data.todo !== undefined && data.todo !== false,
+        failureType: error?.failureType ?? null,
+        cause: cause === null || cause === undefined ? null : { name: bounded(cause.name), code: bounded(cause.code) },
+        witnessed: witness === undefined ? null : witness,
+      })}\n`;
+    } else if (event.type === 'test:summary') {
+      yield `${JSON.stringify({ event: 'summary', counts: data.counts ?? null, success: data.success ?? null })}\n`;
+    }
+  }
+}
diff --git a/tests/tooling/value-cost-witness.mjs b/tests/tooling/value-cost-witness.mjs
new file mode 100644
index 00000000..c25d7c65
--- /dev/null
+++ b/tests/tooling/value-cost-witness.mjs
@@ -0,0 +1,139 @@
+// K1.1-correction-03 review 01 (KC3-R1-EVID-02): the assertion witness for the value-cost probe.
+//
+// Loaded with `--import` before the selected test file. Every module under `packages/kernel/tests/`
+// (test-side code: test files and their helpers, such as `harness.ts`) that imports `node:assert` or
+// `node:assert/strict` receives a wrapping module instead. Each wrapped assertion function calls the real
+// one and, when that throws an `AssertionError`, remembers the error object before rethrowing it. Every
+// other module, the code under test and its dependencies included, receives the real `node:assert`.
+//
+// So a failure counts as a test-side assertion only by where its assertion function was imported, never
+// by a stack frame or an error-class name (TOOLS-01 owner choice 09: a frame cannot establish origin):
+// - an exception thrown while an assertion's arguments are evaluated never enters the wrapper;
+// - an `AssertionError` that the code under test constructs, or throws through its own `node:assert`, is
+//   never remembered.
+//
+// The harness's two unwrapping assertions, `accepted` and `refused` in `packages/kernel/tests/harness.ts`,
+// fail with a plain `Error`. A test-side module that imports the harness therefore receives a wrapping
+// module that re-exports it unchanged, except that those two are wrapped: an error they throw is
+// remembered only when their own assertion condition failed (`accepted` given a result whose `ok` is not
+// true, `refused` given one whose `ok` is true), so an error raised inside them for any other reason is not.
+// The harness file itself is not changed.
+//
+// The reporter (`value-cost-reporter.mjs`) runs in the same process and looks each failure's cause up in
+// `globalThis[Symbol.for("arrokothi.value-cost.witness")]`. A load failure is recorded through
+// `uncaughtExceptionMonitor` into the file named by ARROKOTHI_VALUE_COST_LOAD, so the probe can tell a
+// module that failed to parse from one that threw while loading.
+import { writeFileSync, realpathSync } from 'node:fs';
+import { registerHooks } from 'node:module';
+import { resolve, sep } from 'node:path';
+import { pathToFileURL } from 'node:url';
+import legacyAssert from 'node:assert';
+import strictAssert from 'node:assert/strict';
+
+const WITNESS = Symbol.for('arrokothi.value-cost.witness');
+const ROOT = realpathSync(process.cwd());
+const TEST_SIDE = pathToFileURL(resolve(ROOT, 'packages/kernel/tests') + sep).href;
+const HARNESS = pathToFileURL(resolve(ROOT, 'packages/kernel/tests/harness.ts')).href;
+const HARNESS_WRAPPER = 'arrokothi-witness:harness';
+const HARNESS_REAL = `${HARNESS}?arrokothi-witness-real`;
+const NOT_ASSERTIONS = new Set(['AssertionError', 'CallTracker', 'Assert', 'strict']);
+
+/** Witnessed `AssertionError` objects, each with the name of the assertion function that threw it. */
+const witnessed = new WeakMap();
+globalThis[WITNESS] = witnessed;
+
+const remember = (error, name) => {
+  if (error instanceof strictAssert.AssertionError && !witnessed.has(error)) witnessed.set(error, name);
+};
+
+const wrap = (real, name) => function witnessedAssertion(...args) {
+  let result;
+  try {
+    result = Reflect.apply(real, this, args);
+  } catch (error) {
+    remember(error, name);
+    throw error;
+  }
+  // `rejects` and `doesNotReject` fail asynchronously.
+  if (result !== null && typeof result === 'object' && typeof result.then === 'function') {
+    return result.then(undefined, (error) => {
+      remember(error, name);
+      throw error;
+    });
+  }
+  return result;
+};
+
+const witnessing = (real, label) => {
+  const wrapped = wrap(real, label);
+  for (const key of Object.keys(real)) {
+    const member = real[key];
+    wrapped[key] = typeof member === 'function' && !NOT_ASSERTIONS.has(key) ? wrap(member, `${label}.${key}`) : member;
+  }
+  wrapped.strict = wrapped;
+  return wrapped;
+};
+
+const MODULES = {
+  'arrokothi-witness:assert': witnessing(legacyAssert, 'assert'),
+  'arrokothi-witness:assert/strict': witnessing(strictAssert, 'assert'),
+};
+globalThis[Symbol.for('arrokothi.value-cost.modules')] = MODULES;
+
+const SPECIFIERS = new Map([
+  ['assert', 'arrokothi-witness:assert'],
+  ['node:assert', 'arrokothi-witness:assert'],
+  ['assert/strict', 'arrokothi-witness:assert/strict'],
+  ['node:assert/strict', 'arrokothi-witness:assert/strict'],
+]);
+
+// The harness's unwrapping assertions, each with the condition under which it is meant to fail.
+globalThis[Symbol.for('arrokothi.value-cost.harness')] = {
+  witness(error, name, result, failed) {
+    if (error instanceof Error && result !== null && typeof result === 'object' && failed(result) && !witnessed.has(error)) witnessed.set(error, name);
+  },
+};
+const HARNESS_SOURCE = [
+  `import * as real from ${JSON.stringify(HARNESS_REAL)};`,
+  `export * from ${JSON.stringify(HARNESS_REAL)};`,
+  "const witness = globalThis[Symbol.for('arrokothi.value-cost.harness')].witness;",
+  "export function accepted(result) { try { return real.accepted(result); } catch (error) { witness(error, 'harness.accepted', result, (row) => row.ok !== true); throw error; } }",
+  "export function refused(result) { try { return real.refused(result); } catch (error) { witness(error, 'harness.refused', result, (row) => row.ok === true); throw error; } }",
+].join('\n');
+
+const IDENTIFIER = /^[A-Za-z_$][A-Za-z0-9_$]*$/;
+const source = (url) => {
+  const module = MODULES[url];
+  const lines = [`const module = globalThis[Symbol.for('arrokothi.value-cost.modules')][${JSON.stringify(url)}];`, 'export default module;'];
+  for (const key of Object.keys(module)) {
+    if (IDENTIFIER.test(key) && key !== 'default') lines.push(`export const ${key} = module[${JSON.stringify(key)}];`);
+  }
+  if (!Object.keys(module).includes('strict')) lines.push('export const strict = module;');
+  return lines.join('\n');
+};
+
+registerHooks({
+  resolve(specifier, context, next) {
+    const testSide = typeof context.parentURL === 'string' && context.parentURL.startsWith(TEST_SIDE);
+    const target = SPECIFIERS.get(specifier);
+    if (target !== undefined && testSide) return { url: target, shortCircuit: true };
+    const resolved = next(specifier, context);
+    if (testSide && resolved.url === HARNESS) return { url: HARNESS_WRAPPER, shortCircuit: true };
+    return resolved;
+  },
+  load(url, context, next) {
+    if (Object.hasOwn(MODULES, url)) return { format: 'module', source: source(url), shortCircuit: true };
+    if (url === HARNESS_WRAPPER) return { format: 'module', source: HARNESS_SOURCE, shortCircuit: true };
+    return next(url, context);
+  },
+});
+
+const loadRecord = process.env.ARROKOTHI_VALUE_COST_LOAD;
+process.on('uncaughtExceptionMonitor', (error, origin) => {
+  if (loadRecord === undefined) return;
+  try {
+    writeFileSync(loadRecord, JSON.stringify({ origin, syntax: error instanceof SyntaxError, name: error?.name ?? typeof error }));
+  } catch {
+    // The probe treats a missing record as an unexplained setup failure.
+  }
+});
