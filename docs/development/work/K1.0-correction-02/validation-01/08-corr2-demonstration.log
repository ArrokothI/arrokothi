Program (verbatim; read-only probe, not a production fixture):
// K10-CORR2-01 demonstration. Read-only probe: it imports the committed parser at C and the
// reviewed parser at the round-2 payload C `3646043`, extracted to a temporary path, and runs the
// same derived families through both. It writes nothing into the repository.
import assert from 'node:assert/strict';
import { readFile, writeFile, mkdtemp } from 'node:fs/promises';
import { execFileSync } from 'node:child_process';
import { createHash } from 'node:crypto';
import { tmpdir } from 'node:os';
import { join } from 'node:path';

const ROOT = '/Users/rex-shih/Documents/ArrokothI/arrokothi';
const C = '95d74530f37c7af8706ef92d29574425a39afcf1';
const REVIEWED_C = '36460438e95e968beec0b354b07a616b53981256';

const sh = (...args) => execFileSync('git', args, { cwd: ROOT, encoding: 'utf8' });
console.log(JSON.stringify({ C, inspectedHead: sh('rev-parse', 'HEAD').trim(), reviewedC: REVIEWED_C, node: process.version, platform: process.platform, arch: process.arch }, null, 0));
console.log();

console.log('== byte identity of every input at C ==');
for (const path of [
  'tests/conformance/architecture/inventory-oracle.ts',
  'tests/conformance/architecture/module-graph.ts',
  'tests/conformance/architecture/boundary-policy.ts',
  'docs/development/work/K1.0/ownership-inventory.md',
]) {
  const live = await readFile(join(ROOT, path));
  assert.deepEqual(live, execFileSync('git', ['show', `${C}:${path}`], { cwd: ROOT, maxBuffer: 1 << 28 }));
  console.log(`  ${createHash('sha256').update(live).digest('hex')}  ${path}`);
}
console.log();

// The reviewed parser, extracted beside its unchanged neighbours so it resolves its own imports.
const old = await mkdtemp(join(tmpdir(), 'k10-corr2-reviewed-'));
for (const name of ['inventory-oracle.ts', 'module-graph.ts', 'boundary-policy.ts']) {
  const bytes = execFileSync('git', ['show', `${REVIEWED_C}:tests/conformance/architecture/${name}`], { cwd: ROOT, maxBuffer: 1 << 28 });
  await writeFile(join(old, name), bytes);
  if (name === 'inventory-oracle.ts') console.log(`== reviewed parser at ${REVIEWED_C} ==\n  ${createHash('sha256').update(bytes).digest('hex')}  ${name}`);
}
console.log();

const now = await import(join(ROOT, 'tests/conformance/architecture/inventory-oracle.ts'));
const then = await import(join(old, 'inventory-oracle.ts'));
const { loadWorkspace } = await import(join(ROOT, 'tests/conformance/architecture/module-graph.ts'));
const { ZONES, DEFERRED_EXTRACTIONS } = await import(join(ROOT, 'tests/conformance/architecture/boundary-policy.ts'));

const md = await readFile(join(ROOT, 'docs/development/work/K1.0/ownership-inventory.md'), 'utf8');
const workspace = await loadWorkspace(ROOT);
const policy = { zones: ZONES, deferred: DEFERRED_EXTRACTIONS };
const span = (t) => '`' + t + '`';
const cell = (ts) => ts.map(span).join(', ');
const mutate = (from, to) => { assert.equal(md.split(from).length, 2, `unique anchor: ${from}`); return md.replace(from, to); };
const silent = (mod, text) => mod.inventoryDisagreements(mod.parseInventory(text), policy, workspace).length === 0;

const base = now.parseInventory(md);
assert.deepEqual(now.inventoryDisagreements(base, policy, workspace), [], 'the real inventory still agrees at C');
assert.deepEqual(then.inventoryDisagreements(then.parseInventory(md), policy, workspace), [], 'and agreed under the reviewed parser');
console.log('== the real inventory agrees under both parsers (the correction adds no false report) ==\n');

const columns = [
  { name: 'Export subpaths', anchor: cell(base.packages.get('@arrokothi/core').subpaths), members: [...workspace.packages.get('@arrokothi/core').exports.keys()].sort() },
  { name: 'Zones roots', anchor: cell(base.zones.get('runtime-integrations')), members: [...ZONES.find(z => z.id === 'runtime-integrations').roots].sort() },
];

let oldSilent = 0, newSilent = 0, total = 0;
console.log('== family A: every nontrivial contiguous merge of the sorted collection ==');
for (const col of columns) {
  for (let mask = 0; mask < (1 << (col.members.length - 1)) - 1; mask++) {
    const groups = [col.members[0]];
    for (let i = 1; i < col.members.length; i++) {
      if (mask & (1 << (i - 1))) groups.push(col.members[i]); else groups[groups.length - 1] += ',' + col.members[i];
    }
    const text = mutate(col.anchor, cell(groups));
    const o = silent(then, text), n = silent(now, text);
    total++; if (o) oldSilent++; if (n) newSilent++;
    console.log(`  ${col.name} mask=${String(mask).padStart(2)} members ${col.members.length}->${groups.length}  reviewed=${o ? 'SILENT' : 'loud'}  C=${n ? 'SILENT' : 'loud'}`);
    assert.ok(!n, 'C must report every merged relation');
  }
}
console.log(`  reviewed parser silent on ${oldSilent}/${total}; C silent on ${newSilent}/${total}\n`);

console.log('== family B: the same loss spelled with a separator the old rendering never emits ==');
for (const col of columns) {
  for (const [label, sep] of [['comma+space', ', '], ['space', ' '], ['slash', '/']]) {
    const groups = [`${col.members[0]}${sep}${col.members[1]}`, ...col.members.slice(2)];
    const text = mutate(col.anchor, cell(groups));
    console.log(`  ${col.name} joined by ${label}: reviewed=${silent(then, text) ? 'SILENT' : 'loud'}  C=${silent(now, text) ? 'SILENT' : 'loud'}`);
    assert.ok(!silent(now, text));
  }
}
console.log();

console.log('== family C: the loss in the other direction — an enforced member that spells the separator ==');
{
  const injected = { zones: [...ZONES, { id: 'comma-zone', roots: ['packages/a,packages/b'] }], deferred: DEFERRED_EXTRACTIONS };
  const anchor = '| `host-sdk` | `packages/sdk/src` |';
  const split = mutate(anchor, `${anchor}\n| \`comma-zone\` | \`packages/a\`, \`packages/b\` |`);
  const honest = mutate(anchor, `${anchor}\n| \`comma-zone\` | \`packages/a,packages/b\` |`);
  const named = (mod, text) => mod.inventoryDisagreements(mod.parseInventory(text), injected, workspace).filter(m => m.includes('comma-zone'));
  console.log(`  document splits the one declared root: reviewed=${named(then, split).length === 0 ? 'SILENT' : 'loud'}  C=${named(now, split).length === 0 ? 'SILENT' : 'loud'}`);
  console.log(`    C reports: ${JSON.stringify(named(now, split))}`);
  console.log(`  document spells the one declared root: reviewed=${named(then, honest).length === 0 ? 'accepted' : 'LOUD'}  C=${named(now, honest).length === 0 ? 'accepted' : 'LOUD'}`);
  assert.ok(named(now, split).length > 0 && named(now, honest).length === 0);
}
console.log();

console.log('== permitted spellings: reordering asserts nothing, under both parsers ==');
for (const col of columns) {
  const text = mutate(col.anchor, cell([...col.members].reverse()));
  console.log(`  ${col.name} reversed: reviewed=${silent(then, text) ? 'accepted' : 'LOUD'}  C=${silent(now, text) ? 'accepted' : 'LOUD'}`);
  assert.ok(silent(now, text));
}
console.log();

console.log('== the fourth table: both dependency columns against the same rule ==');
{
  const deps = [
    { zone: 'host-sdk', column: 'reaches', from: '`@arrokothi/core`, `@arrokothi/core/ports`, `@arrokothi/core/reference`', to: '`@arrokothi/core,@arrokothi/core/ports,@arrokothi/core/reference`' },
    { zone: 'runtime-integrations', column: 'thirdParty', from: '`@langchain/core/documents`, `@langchain/textsplitters`, `@modelcontextprotocol/client`, `@modelcontextprotocol/server`, `@strands-agents/sdk`', to: '`@langchain/core/documents,@langchain/textsplitters`, `@modelcontextprotocol/client`, `@modelcontextprotocol/server`, `@strands-agents/sdk`' },
  ];
  for (const d of deps) {
    const honest = now.parseDependencyTable(md).rows.get(d.zone)[d.column];
    const merged = now.parseDependencyTable(mutate(d.from, d.to)).rows.get(d.zone)[d.column];
    const report = now.collectionDisagreement(`${d.zone} ${d.column}`, honest, merged);
    console.log(`  ${d.zone}.${d.column}: ${honest.length} members -> ${merged.length}; shared rule says ${JSON.stringify(report)}`);
    assert.notEqual(report, undefined);
    assert.equal(now.collectionDisagreement(`${d.zone} ${d.column}`, honest, honest), undefined);
    assert.ok(Array.isArray(honest), 'the parsed relation carries decoded members, not a set');
  }
}
console.log();

console.log('== adjacent consumer left alone: the Deferred scalar tuple still distinguishes its fields ==');
for (const [label, from, to, needle] of [
  ['separator-bearing owner', '| DX-1 | `packages/core/src/util/hash.ts` | migratable | K1.1 |', '| DX-1 | `packages/core/src/util/hash.ts` | migratable | K1.1,K3.1 |', 'K1.1,K3.1'],
  ['changed disposition', '| DX-5 | `packages/core/src/runtime/harness.ts` | legacy-only | K1.4 |', '| DX-5 | `packages/core/src/runtime/harness.ts` | migratable | K1.4 |', 'DX-5 is legacy-only'],
]) {
  const reported = now.inventoryDisagreements(now.parseInventory(mutate(from, to)), policy, workspace);
  console.log(`  ${label}: ${JSON.stringify(reported.filter(m => m.includes(needle)))}`);
  assert.ok(reported.some(m => m.includes(needle)));
}
console.log();
console.log(`DEMONSTRATED: the reviewed parser accepted ${oldSilent} of ${total} false collections; C accepts ${newSilent}. Exit 0 records these observations, not packet acceptance.`);

