  const ownerSeen = ownerDis.some((m: string) => /deferred row DX-3 is owned by K1\.1 but the document says K1\.1 or later/.test(m));
  console.log(`downstream decoded-but-false owner reaches consumer: ${ownerSeen} ${JSON.stringify(ownerDis)}`);
  if (newDis.length !== 0 || !ownerSeen) throw new Error("downstream check failed");
  console.log(`reference-vs-new disagreements: ${refNewBad}; old-vs-reference misses: ${oldRefBad}; documents: ${docs.length}`);
  if (refNewBad !== 0) throw new Error("audit failed");
} finally {
  await rm(resolve(ROOT, TMP), { force: true });
}
