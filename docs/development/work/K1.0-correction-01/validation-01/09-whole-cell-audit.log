--- cell-reference.mts ---
/**
 * An INDEPENDENT reference for K1.0-C4's governed cell languages.
 *
 * Round 15 of this packet produced an audit whose "expected" column was hand-typed by the author of
 * the parser, from the same reading that produced the parser, so it agreed with the parser's bug and
 * reported a clean sheet. Review-16 rejected that, and round 16 replaced the column with an executed
 * transliteration of quoted specification sentences. This module is the same device for cell values,
 * with the quoting step hardened further: the sentences are not retyped here at all. Each one is a
 * verbatim substring READ FROM the repository file that owns it at run time, and the module refuses
 * to run if any of them is not found there, so the audit cannot quote a sentence the sources do not
 * actually contain.
 *
 * Independence from the implementation:
 *
 * - it imports nothing from `inventory-oracle.ts` and shares no helper with it;
 * - it recognises each language with a whole-cell regular expression plus a canonical re-render
 *   equality (decode, print the document's canonical spelling, require it back), where the
 *   implementation uses a left-to-right index walk. Two different algorithms for one language.
 * - the count language is decided by the round trip `String(n) === cell`, which is a statement about
 *   decimal rendering rather than a transcription of the implementation's regular expression.
 *
 * The one place independence is weak, stated rather than hidden: the `Published?` column is a closed
 * three-word vocabulary, so both sides necessarily contain the same three words. The audit reports
 * that column's agreement for completeness, not as independent evidence.
 */

import { readFile } from "node:fs/promises";
import { resolve } from "node:path";

const REPO = "/Users/rex-shih/Documents/ArrokothI/arrokothi";
const INVENTORY = "docs/development/work/K1.0/ownership-inventory.md";
const CONTRACT = "docs/development/work/K1.0/contract.md";

/** A sentence this reference is derived from, and the repository file that must contain it. */
export interface Quote {
  readonly id: string;
  readonly source: string;
  readonly text: string;
  readonly governs: string;
}

export const QUOTES: readonly Quote[] = [
  {
    id: "DOC-LIST",
    source: INVENTORY,
    text: "| `runtime-integrations` | `packages/agents/strands/src`, `packages/models/gemini/src`, `packages/retrieval/local/src`, `packages/interoperability/mcp/src` |",
    governs: "the document's own spelling of a multi-valued cell: code spans separated by a comma and a space",
  },
  {
    id: "DOC-ONE",
    source: INVENTORY,
    text: "| `host-sdk` | `packages/sdk/src` |",
    governs: "the document's own spelling of a single-valued cell: exactly one code span",
  },
  {
    id: "DOC-NORMALISED",
    source: INVENTORY,
    text: "One row per package, with a normalised `Published?` value, so the agreement oracle can compare the\nrow relation against the manifests rather than checking that each name occurs somewhere on the page.",
    governs: "the publishability column is a normalised vocabulary, not free text searched for a word",
  },
  {
    id: "DOC-MEASURED",
    source: INVENTORY,
    text: "Measured over the candidate tree (the payload commit named in the implementation report) by the\nsame analyzer the guards use, over every `.ts` file in each zone",
    governs: "the file-count column asserts one measured number of files",
  },
  {
    id: "DOC-EMPTY",
    source: INVENTORY,
    text: "| `target-kernel` | 2 | nothing | nothing |",
    governs: "`nothing` is the document's whole-cell spelling of an empty edge set",
  },
  {
    id: "DOC-SELF",
    source: INVENTORY,
    text: "| `legacy-core` | 143 | — | nothing |",
    governs: "the em dash is the workspace column's whole-cell spelling of self, not cross-boundary",
  },
  {
    id: "C4-TOTAL",
    source: CONTRACT,
    text: "Parsing is **total**: every candidate row ends in exactly one outcome",
    governs: "a cell that is not one of the languages above must make its row an outcome, never a partial read",
  },
  {
    id: "C4-RELATION",
    source: CONTRACT,
    text: "Agreement is checked **per row relation**, not per token set",
    governs: "the decoded value is what is compared, so a discarded part of a cell is a claim nobody compares",
  },
];

/** Reads each quote from its source file and fails loudly if it is not there verbatim. */
export async function verifyQuotes(): Promise<{ readonly id: string; readonly source: string; readonly text: string; readonly governs: string; readonly offset: number }[]> {
  const verified: { id: string; source: string; text: string; governs: string; offset: number }[] = [];
  const cache = new Map<string, string>();
  for (const quote of QUOTES) {
    if (!cache.has(quote.source)) cache.set(quote.source, await readFile(resolve(REPO, quote.source), "utf8"));
    const body = cache.get(quote.source)!;
    const offset = body.indexOf(quote.text);
    if (offset === -1) throw new Error(`quote ${quote.id} is not present verbatim in ${quote.source}`);
    if (body.indexOf(quote.text, offset + 1) !== -1) throw new Error(`quote ${quote.id} is not unique in ${quote.source}`);
    verified.push({ ...quote, offset });
  }
  return verified;
}

const SPACE_OR_TAB = "[ " + String.fromCharCode(0x09) + "]";
const SEPARATOR = new RegExp(SPACE_OR_TAB + "*," + SPACE_OR_TAB + "*", "g");
const LIST_CELL = new RegExp("^`[^`]+`(?:" + SPACE_OR_TAB + "*," + SPACE_OR_TAB + "*`[^`]+`)*$");

/**
 * DOC-LIST / DOC-ONE. A list cell decodes iff the whole cell matches the document's spelling AND
 * re-rendering the decoded tokens in that spelling reproduces the cell, once every separator is
 * normalised to the canonical ", ". The round trip is what makes this a fidelity statement rather
 * than a pattern match: nothing in the cell can fail to appear in the decoded value.
 */
export function referenceList(cell: string): string[] | undefined {
  if (!LIST_CELL.test(cell)) return undefined;
  const tokens = [...cell.matchAll(/`([^`]+)`/g)].map((match) => match[1]!);
  if (new Set(tokens).size !== tokens.length) return undefined;
  const canonical = tokens.map((token) => "`" + token + "`").join(", ");
  return cell.replace(SEPARATOR, ", ") === canonical ? tokens : undefined;
}

/** DOC-ONE. Exactly one token, so a single-valued column cannot silently drop a second one. */
export function referenceOne(cell: string): string | undefined {
  const tokens = referenceList(cell);
  return tokens !== undefined && tokens.length === 1 ? tokens[0] : undefined;
}

/**
 * DOC-MEASURED. A count cell decodes to n iff printing n reproduces the cell exactly. That single
 * round trip rejects a sign, a decimal point, an exponent, a separator, a leading zero, any suffix
 * and any magnitude that would not survive the trip — without enumerating any of them.
 */
export function referenceCount(cell: string): number | undefined {
  if (!/^[0-9]+$/.test(cell)) return undefined;
  const value = Number(cell);
  return Number.isSafeInteger(value) && String(value) === cell ? value : undefined;
}

/** DOC-EMPTY / DOC-SELF. One whole-cell sentinel, or a list; never a sentinel found inside a cell. */
export function referenceEdges(cell: string, sentinels: readonly string[]): string[] | undefined {
  if (sentinels.includes(cell)) return [];
  return referenceList(cell);
}

/**
 * DOC-NORMALISED. A closed vocabulary. Independence here is weak by construction and the audit says
 * so: any correct reading of "a normalised `Published?` value" contains the same three spellings.
 */
export function referencePublished(cell: string): boolean | undefined {
  if (cell === "Yes") return true;
  if (cell === "No" || cell === "No (private)") return false;
  return undefined;
}

export const REACHES_SENTINELS = ["nothing", String.fromCharCode(0x2014)] as const;
export const THIRD_PARTY_SENTINELS = ["nothing"] as const;
--- end cell-reference.mts ---

== the audit driver, quoted in full ==
--- audit-cells.mts ---
/**
 * Whole-cell decoding audit: an INDEPENDENT reference vs the accepted H vs the committed C.
 *
 * Three executed columns, never a hand-typed one. The reference is `cell-reference.mts`, which
 * quotes its governing sentences by reading them out of the repository files that own them and
 * recognises each cell language by a different algorithm than the parser uses. The H column is the
 * accepted candidate's `inventory-oracle.ts` taken byte-for-byte from
 * `git show f3aa29d7ecba2a23aa85788b7efdebdd383cab24:...`; its imports are type-only and erased by
 * `--experimental-strip-types`, so it runs standalone and is the accepted code rather than a
 * paraphrase. The C column is the committed parser imported from its real repository path.
 *
 * Both parsers are driven through the production entry points on the real ownership inventory with
 * exactly one cell replaced, so every row reported here went through section selection, table
 * discovery, row splitting, keying, duplicate checking and value decoding.
 *
 * The number that matters is the count of rows where H and C agree while the reference differs:
 * that is the shape a shared authorial assumption would take, and it must be zero.
 */

import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import {
  QUOTES,
  REACHES_SENTINELS,
  THIRD_PARTY_SENTINELS,
  referenceCount,
  referenceEdges,
  referenceList,
  referenceOne,
  referencePublished,
  verifyQuotes,
} from "./cell-reference.mts";

const REPO = "/Users/rex-shih/Documents/ArrokothI/arrokothi";
const ARCH = `${REPO}/tests/conformance/architecture`;
const H_ORACLE = new URL("./oracle-H16.ts", import.meta.url).pathname;

const H = await import(H_ORACLE);
const C = await import(`${ARCH}/inventory-oracle.ts`);

const real = await readFile(resolve(REPO, "docs/development/work/K1.0/ownership-inventory.md"), "utf8");
const TAB = String.fromCharCode(0x09);
const VT = String.fromCharCode(0x0b);
const NBSP = String.fromCharCode(0xa0);
const EM = String.fromCharCode(0x2014);

const splice = (from: string, to: string): string => {
  if (real.split(from).length - 1 !== 1) throw new Error(`anchor is not unique: ${JSON.stringify(from)}`);
  return real.replace(from, to);
};

const show = (value: unknown): string => (value === undefined ? "UNREADABLE" : JSON.stringify(value));

/** One audited column: how to place a cell in the document, and how to read the decoded value back. */
interface Column {
  readonly name: string;
  readonly place: (cell: string) => string;
  readonly read: (module: typeof C, markdown: string) => unknown;
  readonly reference: (cell: string) => unknown;
  readonly cells: readonly string[];
  readonly independent: boolean;
}

const ZONE_ROW =
  "| `target-kernel` | `packages/kernel/src` | New Kernel work under the target Activation/Outcome protocol. **Contains no protocol implementation at this revision.** |";
const DX1_ROW =
  "| DX-1 | `packages/core/src/util/hash.ts` | migratable | K1.1 | First packet that needs stable identity/receipt hashing. |";
const CORE_ROW = "| `@arrokothi/core` | `.`, `./execution`, `./ports`, `./reference`, `./testing` | Yes |";
const KERNEL_ROW = "| `@arrokothi/kernel` | `.` | No (private) |";
const DEP_ROW = "| `target-kernel` | 2 | nothing | nothing |";

/** Spellings shared by every list-valued column, so one family is audited the same way everywhere. */
const LIST_CELLS = (one: string, two: string): readonly string[] => [
  `\`${one}\``,
  `\`${one}\`, \`${two}\``,
  `\`${one}\`,\`${two}\``,
  `\`${one}\` ,  \`${two}\``,
  `\`${one}\`,${TAB}\`${two}\``,
  `\`${one}\`, \`${one}\``,
  `\`${one}\`, ${two}`,
  `${one}`,
  `\`${one}\` and \`${two}\``,
  `\`${one}\`, \`${two}\`,`,
  `see \`${one}\``,
  `\`${one}\` (deprecated)`,
  "``",
  "",
  "nothing",
  `\`${one}\`${NBSP}`,
  `\`${one}\`${VT}`,
];

const COLUMNS: readonly Column[] = [
  {
    name: "Zones.roots",
    place: (cell) => splice(ZONE_ROW, `| \`target-kernel\` | ${cell} | New Kernel work under the target Activation/Outcome protocol. **Contains no protocol implementation at this revision.** |`),
    read: (module, markdown) => module.parseInventory(markdown).zones.get("target-kernel"),
    reference: (cell) => referenceList(cell),
    cells: LIST_CELLS("packages/kernel/src", "packages/evil/src"),
    independent: true,
  },
  {
    name: "Deferred.currentPath",
    place: (cell) => splice(DX1_ROW, `| DX-1 | ${cell} | migratable | K1.1 | First packet that needs stable identity/receipt hashing. |`),
    read: (module, markdown) => module.parseInventory(markdown).deferred.get("DX-1")?.currentPath,
    reference: (cell) => referenceOne(cell),
    cells: LIST_CELLS("packages/core/src/util/hash.ts", "packages/core/src/util/json.ts"),
    independent: true,
  },
  {
    name: "Export.subpaths",
    place: (cell) => splice(CORE_ROW, `| \`@arrokothi/core\` | ${cell} | Yes |`),
    read: (module, markdown) => module.parseInventory(markdown).packages.get("@arrokothi/core")?.subpaths,
    reference: (cell) => referenceList(cell),
    cells: [
      "`.`, `./execution`, `./ports`, `./reference`, `./testing`",
      "`.`,`./execution`, `./ports`, `./reference`,`./testing`",
      "`.`, `./execution`, `./ports`, `./reference`, `./testing`, ./secret",
      "`.`, `./execution`, `./ports`, `./reference`, `./testing` and more",
      "`.`, `./execution`, `./ports`, `./reference`",
      "`.`, `./execution`, `./ports`, `./reference`, `./testing`, `./testing`",
    ],
    independent: true,
  },
  {
    name: "Export.published",
    place: (cell) => splice(KERNEL_ROW, `| \`@arrokothi/kernel\` | \`.\` | ${cell} |`),
    read: (module, markdown) => module.parseInventory(markdown).packages.get("@arrokothi/kernel")?.published,
    reference: (cell) => referencePublished(cell),
    cells: [
      "Yes",
      "No",
      "No (private)",
      "Yes, but only in theory",
      "Yes (private)",
      "No, it is published",
      "nope",
      "No.",
      "yes",
      "YES",
      `No (private)${NBSP}`,
      "",
    ],
    independent: false,
  },
  {
    name: "Dependency.files",
    place: (cell) => splice(DEP_ROW, `| \`target-kernel\` | ${cell} | nothing | nothing |`),
    read: (module, markdown) => module.parseDependencyTable(markdown).rows.get("target-kernel")?.files,
    reference: (cell) => referenceCount(cell),
    cells: ["2", "0", "7", "143", "2.5", "2oops", "+2", "-2", "02", "2e0", "0x2", "2,000", "1/2", "two", "2 files", "", "9007199254740993"],
    independent: true,
  },
  {
    name: "Dependency.reaches",
    place: (cell) => splice(DEP_ROW, `| \`target-kernel\` | 2 | ${cell} | nothing |`),
    read: (module, markdown) => {
      const row = module.parseDependencyTable(markdown).rows.get("target-kernel");
      return row === undefined ? undefined : [...row.reaches];
    },
    reference: (cell) => referenceEdges(cell, REACHES_SENTINELS),
    cells: [
      "nothing",
      EM,
      "`@arrokothi/core`",
      "`@arrokothi/core`, `@arrokothi/core/ports`",
      "nothing, `@arrokothi/core`",
      "`@arrokothi/core`, nothing",
      "nothing at all",
      "Nothing",
      "nothing (for now)",
      "`@arrokothi/core` and nothing else",
      `${EM}, \`@arrokothi/core\``,
      "",
    ],
    independent: true,
  },
  {
    name: "Dependency.thirdParty",
    place: (cell) => splice(DEP_ROW, `| \`target-kernel\` | 2 | nothing | ${cell} |`),
    read: (module, markdown) => {
      const row = module.parseDependencyTable(markdown).rows.get("target-kernel");
      return row === undefined ? undefined : [...row.thirdParty];
    },
    reference: (cell) => referenceEdges(cell, THIRD_PARTY_SENTINELS),
    cells: [
      "nothing",
      EM,
      "`evil-package`",
      "nothing, `evil-package`",
      "`evil-package`, nothing",
      "Nothing",
      "nothing yet",
      "",
    ],
    independent: true,
  },
];

const pad = (text: string, width: number): string => (text.length >= width ? text : text + " ".repeat(width - text.length));
/** Renders a cell for the log with every invisible or non-ASCII character spelled out. */
const escape = (cell: string): string => {
  let out = '"';
  for (const ch of cell) {
    const code = ch.codePointAt(0)!;
    if (ch === '"') out += '\\"';
    else if (ch === "\\") out += "\\\\";
    else if (code >= 0x20 && code <= 0x7e) out += ch;
    else out += "\\u" + code.toString(16).padStart(4, "0");
  }
  return out + '"';
};

console.log("== governing sentences, read verbatim out of the repository files that own them ==");
console.log("");
for (const quote of await verifyQuotes()) {
  console.log(`[${quote.id}] ${quote.source} @ byte ${quote.offset}`);
  console.log(`  governs: ${quote.governs}`);
  for (const line of quote.text.split("\n")) console.log(`  > ${line}`);
  console.log("");
}
console.log(`All ${QUOTES.length} sentences were found verbatim and uniquely; the reference refuses to run otherwise.`);
console.log("");

let total = 0;
let cWrong = 0;
let hWrong = 0;
let bothWrongTogether = 0;
let distinguishing = 0;

for (const column of COLUMNS) {
  console.log("");
  console.log(`== ${column.name}${column.independent ? "" : "   (closed vocabulary: independence is weak here by construction)"} ==`);
  console.log(pad("cell", 62), pad("reference", 26), pad("H f3aa29d7", 26), "C 76ce938");
  console.log("-".repeat(146));
  for (const cell of column.cells) {
    const markdown = column.place(cell);
    const expected = show(column.reference(cell));
    const h = show(column.read(H, markdown));
    const c = show(column.read(C, markdown));
    total++;
    if (c !== expected) cWrong++;
    if (h !== expected) hWrong++;
    if (h === c && c !== expected) bothWrongTogether++;
    if (h !== c) distinguishing++;
    const flag = c === expected ? (h === c ? "" : "   <- distinguishing") : "   <- C DISAGREES WITH THE REFERENCE";
    console.log(pad(escape(cell), 62), pad(expected, 26), pad(h, 26), c + flag);
  }
}

console.log("");
console.log("-".repeat(146));
console.log(`cells ${total}; C disagrees with the reference ${cWrong}; H disagrees with the reference ${hWrong};`);
console.log(`H and C agree while the reference differs (a shared assumption would look like this): ${bothWrongTogether};`);
console.log(`distinguishing (H != C): ${distinguishing}`);

// ---------------------------------------------------------------- non-vacuity
console.log("");
console.log("== non-vacuity: every governed cell of the REAL inventory, reference vs C ==");
const parsed = C.parseInventory(real);
const dependency = C.parseDependencyTable(real);
let checked = 0;
const mismatches: string[] = [];

const rowsOf = (heading: string, next: string): string[][] => {
  const body = real.slice(real.indexOf(`## ${heading}`), real.indexOf(`## ${next}`));
  return body
    .split("\n")
    .filter((line) => line.startsWith("| ") && !/^\|[-:| ]+\|$/.test(line))
    .map((line) => line.slice(1, line.lastIndexOf("|")).split("|").map((cell) => cell.trim()))
    .slice(1);
};

for (const cells of rowsOf("Zones", "Current cross-boundary dependencies")) {
  const key = referenceOne(cells[0]!);
  const roots = referenceList(cells[1]!);
  checked += 2;
  if (key === undefined || JSON.stringify(parsed.zones.get(key)) !== JSON.stringify(roots)) mismatches.push(`Zones ${cells[0]}`);
}
for (const cells of rowsOf("Current cross-boundary dependencies", "Export ownership")) {
  const key = referenceOne(cells[0]!);
  checked += 4;
  const row = key === undefined ? undefined : dependency.rows.get(key);
  const files = referenceCount(cells[1]!);
  const reaches = referenceEdges(cells[2]!, REACHES_SENTINELS);
  const third = referenceEdges(cells[3]!, THIRD_PARTY_SENTINELS);
  if (
    row === undefined ||
    row.files !== files ||
    JSON.stringify([...row.reaches]) !== JSON.stringify(reaches) ||
    JSON.stringify([...row.thirdParty]) !== JSON.stringify(third)
  ) {
    mismatches.push(`Dependency ${cells[0]}`);
  }
}
for (const cells of rowsOf("Export ownership", "What the target zone may import")) {
  const key = referenceOne(cells[0]!);
  checked += 3;
  const row = key === undefined ? undefined : parsed.packages.get(key);
  if (
    row === undefined ||
    JSON.stringify(row.subpaths) !== JSON.stringify(referenceList(cells[1]!)) ||
    row.published !== referencePublished(cells[2]!)
  ) {
    mismatches.push(`Export ${cells[0]}`);
  }
}
for (const cells of rowsOf("Deferred extraction and bridge owners", "What this packet does not establish")) {
  const key = /^DX-\d+$/.test(cells[0]!) ? cells[0]! : undefined;
  checked += 4;
  const row = key === undefined ? undefined : parsed.deferred.get(key);
  if (row === undefined || row.currentPath !== referenceOne(cells[1]!) || row.disposition !== cells[2] || row.owner !== cells[3]) {
    mismatches.push(`Deferred ${cells[0]}`);
  }
}

console.log(`governed cells checked: ${checked}; rows whose reference decoding differs from C: ${mismatches.length}`);
if (mismatches.length > 0) console.log(mismatches.join("\n"));

if (cWrong !== 0 || bothWrongTogether !== 0 || mismatches.length !== 0) process.exitCode = 1;
