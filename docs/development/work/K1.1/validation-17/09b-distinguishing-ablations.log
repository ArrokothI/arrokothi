"""Ablation X9: one shared coordinator-global visible position for receipts and refusals.

Reintroduces the K11-R12-ID-01 defect class on top of the corrected ownership model: every
accepted boundary and every refusal advances a single coordinator-wide counter, and the
resulting number is exposed as Receipt.position (and embedded in the token via mintReceipt).
The nondisclosure oracle must reject this.
"""
path = "packages/kernel/src/coordinator.ts"
s = open(path).read()

anchor_field = "  readonly #byCreationKey = new PrimordialMap<string, ExecutionRecord>();\n"
assert s.count(anchor_field) == 1, "X9 field anchor not unique/found"
s = s.replace(
    anchor_field,
    anchor_field + "  #acceptancePosition = 0;\n",
)

old_mint = """  #mint(boundary: ReceiptBoundary, record: ExecutionRecord): Receipt {
    const position = record.nextAcceptancePosition;
    record.nextAcceptancePosition += 1;
    return mintReceipt(boundary, position, record.executionId);
  }
"""
new_mint = """  #mint(boundary: ReceiptBoundary, record: ExecutionRecord): Receipt {
    this.#acceptancePosition += 1;
    record.nextAcceptancePosition += 1;
    return mintReceipt(boundary, this.#acceptancePosition, record.executionId);
  }
"""
assert s.count(old_mint) == 1, "X9 mint anchor not unique/found"
s = s.replace(old_mint, new_mint)

old_null = "    if (record === null) return mintRefusal(classification, reason, 0, null);\n"
new_null = """    this.#acceptancePosition += 1;
    if (record === null) return mintRefusal(classification, reason, this.#acceptancePosition, null);
"""
assert s.count(old_null) == 1, "X9 null-refusal anchor not unique/found"
s = s.replace(old_null, new_null)

old_attached = """    const position = record.nextRefusalPosition;
    record.nextRefusalPosition += 1;
"""
new_attached = """    this.#acceptancePosition += 1;
    const position = this.#acceptancePosition;
    record.nextRefusalPosition += 1;
"""
assert s.count(old_attached) == 1, "X9 attached-refusal anchor not unique/found"
s = s.replace(old_attached, new_attached)

open(path, "w").write(s)
print("X9 edit applied")
PYEOF
