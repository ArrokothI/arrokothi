"""Ablation XA: defineData builds an ordinary descriptor literal (install direction only)."""
path = "packages/kernel/src/own-array.ts"
s = open(path).read()
old = """  const descriptor = PrimordialObjectCreate(null) as {
    value: unknown;
    writable: boolean;
    enumerable: boolean;
    configurable: boolean;
  };
  descriptor.value = value;
