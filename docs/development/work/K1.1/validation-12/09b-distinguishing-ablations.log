$ cat > /tmp/k11-edit-X1.py <<'PYEOF'
"""Ablation X1: defineAt reverts to ordinary indexed assignment."""
path = "packages/kernel/src/own-array.ts"
s = open(path).read()
old = "  defineData(list, `${index}`, value, true, true, true);\n"
new = "  (list as unknown as Record<string, T>)[`${index}`] = value;\n"
assert s.count(old) == 1, "X1 anchor not unique/found"
open(path, "w").write(s.replace(old, new))
print("X1 edit applied")
PYEOF
